def fuzzy_score(q: str, s: str) -> int:
    """Subsequence fuzzy match: substring hits rank first, then subsequence."""
    q, s = q.lower(), s.lower()
    if not q:
        return 0
    if q in s:
        return 100 + len(q)
    pos, score = 0, 0
    for ch in q:
        i = s.find(ch, pos)
        if i < 0:
            return -1
        score += 2 if i == pos else 1
        pos = i + 1
    return score


def filter_palette(items: list[dict], q: str) -> list[dict]:
    scored = []
    for it in items:
        sc = fuzzy_score(q, it["label"] + " " + it["desc"])
        if sc >= 0:
            scored.append((sc, it))
    scored.sort(key=lambda x: -x[0])
    return [it for _, it in scored[:25]]


