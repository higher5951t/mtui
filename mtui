def sel_max(state: TerminalState, app: App) -> int:
    """Maximum selection index for the current screen (0-based, inclusive)."""
    key = SCREENS[state.screen]["key"]
    if key == "matrix":
        return max(0, len(state.order) - 1)
    if key == "policy":
        return max(0, len(app.cache("policy_events", app.policy_events)) - 1)
    if key == "audit":
        return max(0, len(app.cache(f"audit_{state.audit_imputed_only}",
                                    lambda: app.audit_rows(state.audit_imputed_only))) - 1)
    if key == "system":
        return max(0, len(SYSTEM_ACTIONS) - 1)
    if key == "market":
        return max(0, len(_market_items(state)) - 1)
    if key == "papertrade":
        return max(0, len(app.cache("pt_runs", app.papertrade_runs)) - 1)
    return 0


def scroll_max(state: TerminalState, app: App) -> int:
    key = SCREENS[state.screen]["key"]
    inner = max(2, state._vis_h - 4) if getattr(state, "_vis_h", 0) else 10
    if key == "matrix":
        return max(0, len(state.order) - inner)
    if key == "policy":
        return max(0, len(app.cache("policy_events", app.policy_events)) - inner)
    if key == "audit":
        return max(0, len(app.cache(f"audit_{state.audit_imputed_only}",
                                    lambda: app.audit_rows(state.audit_imputed_only))) - inner)
    if key == "system":
        return max(0, len(SYSTEM_ACTIONS) - inner)
    if key == "market":
        return max(0, len(_market_items(state)) - inner)
    if key == "papertrade":
        return max(0, len(app.cache("pt_runs", app.papertrade_runs)) - inner)
    return 0


# ── navigation ──────────────────────────────────────────────────────────────
def h_move(state: TerminalState, app: App, d: int) -> None:
    if state.focus == "nav":
        state.screen = (state.screen + d) % len(SCREENS)
        state.sel = 0
        return
    key = SCREENS[state.screen]["key"]
    inner = max(2, (getattr(state, "_vis_h", None) or 10) - 4)
    if key == "policy":                            # policy list uses policy_sel
        n = len(app.cache("policy_events", app.policy_events))
        if n:
            state.policy_sel = max(0, min(state.policy_sel + d, n - 1))
            if state.policy_sel < state.vscroll:
                state.vscroll = state.policy_sel
            if state.policy_sel >= state.vscroll + inner:
                state.vscroll = state.policy_sel - inner + 1
        return
    if key == "papertrade":                       # backtest list uses papertrade_sel
        n = len(app.cache("pt_runs", app.papertrade_runs))
        if n:
            state.papertrade_sel = max(0, min(state.papertrade_sel + d, n - 1))
            if state.papertrade_sel < state.vscroll:
                state.vscroll = state.papertrade_sel
            if state.papertrade_sel >= state.vscroll + inner:
                state.vscroll = state.papertrade_sel - inner + 1
        return
    if key == "market":                            # market list uses market_sel
        n = len(_market_items(state))
        if n:
            state.market_sel = max(0, min(state.market_sel + d, n - 1))
            if state.market_sel < state.vscroll:
                state.vscroll = state.market_sel
            if state.market_sel >= state.vscroll + inner:
                state.vscroll = state.market_sel - inner + 1
        return
    mx = sel_max(state, app)
    state.sel = max(0, min(state.sel + d, mx))
    if state.sel < state.vscroll:
        state.vscroll = state.sel
    if state.sel >= state.vscroll + inner:
        state.vscroll = state.sel - inner + 1


def h_scroll(state: TerminalState, app: App, d: int, page: bool = False) -> None:
    mx = scroll_max(state, app)
    step = max(3, (getattr(state, "_vis_h", 10) or 10) // 2) if page else 1
    state.vscroll = max(0, min(state.vscroll + d * step, mx))


def h_hscroll(state: TerminalState, app: App, d: int, page: bool = False) -> None:
    key = SCREENS[state.screen]["key"]
    if key != "matrix":
        return
    widths = [2 + w for w in MATRIX_COL_WIDTHS]
    k, acc = 0, 0
    while k < len(widths) and acc + widths[k] <= app.content_w:
        acc += widths[k]
        k += 1
    k = max(1, k)
    mx = max(0, len(widths) - k)
    step = k if page else 1
    state.hscroll = max(0, min(state.hscroll + d * step, mx))


def h_top(state: TerminalState, app: App) -> None:
    if state.focus == "nav":
        state.screen = 0
        state.sel = 0
    else:
        key = SCREENS[state.screen]["key"]
        if key == "market":
            state.market_sel = 0
        elif key == "papertrade":
            state.papertrade_sel = 0
        elif key == "policy":
            state.policy_sel = 0
        state.sel = 0
        state.vscroll = 0


def h_bottom(state: TerminalState, app: App) -> None:
    if state.focus == "nav":
        state.screen = len(SCREENS) - 1
        state.sel = 0
        return
    key = SCREENS[state.screen]["key"]
    if key == "market":
        state.market_sel = max(0, len(_market_items(state)) - 1)
        if state.market_sel > 0:
            state.vscroll = state.market_sel - 1
        return
    if key == "papertrade":
        state.papertrade_sel = max(0, len(app.cache("pt_runs", app.papertrade_runs)) - 1)
        if state.papertrade_sel > 0:
            state.vscroll = state.papertrade_sel - 1
        return
    if key == "policy":
        state.policy_sel = max(0, len(app.cache("policy_events", app.policy_events)) - 1)
        if state.policy_sel > 0:
            state.vscroll = state.policy_sel - 1
        return
    state.sel = sel_max(state, app)
    state.vscroll = max(0, state.sel - 1)


# ── mode / focus ────────────────────────────────────────────────────────────
def h_focus_content(state: TerminalState, app: App) -> None:
    if state.focus == "pane2":               # move to the left pane's content
        activate_pane(state, 1)
        state.focus = "content"
    elif state.focus != "content":
        state.focus = "content"
    state.nav_expanded = False


def h_focus_nav(state: TerminalState, app: App) -> None:
    if state.focus == "pane2":
        activate_pane(state, 1)
    state.focus = "nav"
    state.nav_expanded = True
    if state.mode in ("palette", "search", "watchlist", "help"):
        state.mode = "normal"


def h_focus_cycle(state: TerminalState, app: App) -> None:
    """Tab: nav rail → left pane → right pane → nav rail."""
    if state.focus == "nav":
        state.focus = "content"
        state.nav_expanded = False
    elif state.focus == "content":
        if state.layout == "hsplit":
            activate_pane(state, 2)           # materialize the right pane
            state.focus = "pane2"
        else:
            state.focus = "nav"
            state.nav_expanded = True
    else:                                       # "pane2" → back to nav rail
        activate_pane(state, 1)
        state.focus = "nav"
        state.nav_expanded = True


def h_enter(state: TerminalState, app: App) -> None:
    if state.focus == "nav":
        state.focus = "content"
        return
    key = SCREENS[state.screen]["key"]
    if key == "matrix" and state.order:
        iso = state.order[state.sel]
        state.sel_iso = iso
        state.screen = 2
        app.log_action(f"open {iso}")
        app.toast(f"{iso} deep-dive")
    elif key == "market":
        # detail pane is always visible; Enter is a no-op (selection IS the
        # detail). Resolve the selected item from the *displayed* list: the
        # market_data dict is in poll order, so indexing it directly by
        # market_sel reports the wrong ticker once sort/filter is active.
        items = _market_items(state)
        if items and 0 <= state.market_sel < len(items):
            tag, d = items[state.market_sel]
            app.toast(f"detail: {d.get('label') or tag}")
        else:
            app.toast("no market data yet")
    elif key == "audit":
        # rows present: dive into the selected audit row's country
        # table empty:   run the selected ETL quick action instead
        rows = app.cache(f"audit_{state.audit_imputed_only}",
                         lambda: app.audit_rows(state.audit_imputed_only))
        if rows and 0 <= state.sel < len(rows):
            state.sel_iso = rows[state.sel]["iso"]
            state.screen = 2
            app.toast(rows[state.sel]["iso"] + " deep-dive")
        elif not rows and 0 <= state.sel < len(AUDIT_QUICK):
            title, argv, _d = AUDIT_QUICK[state.sel]
            app.run_job(title, argv)
    elif key == "system":
        if 0 <= state.sel < len(SYSTEM_ACTIONS):
            title, argv, _d = SYSTEM_ACTIONS[state.sel]
            app.run_job(title, argv)
    elif key == "policy":
        pass


def h_market_sort(state: TerminalState, app: App) -> None:
    keys = ["default", "px", "chg", "pct", "name"]
    state.market_sort = keys[(keys.index(state.market_sort) + 1) % len(keys)]
    app.toast(f"market sort: {state.market_sort}")
    app.log_action(f"mkt sort {state.market_sort}")


def h_market_filter_cycle(state: TerminalState, app: App) -> None:
    cats = [""] + sorted({t[3] for t in TICKERS})
    try:
        idx = cats.index(state.market_filter_cat)
    except ValueError:
        idx = 0
    state.market_filter_cat = cats[(idx + 1) % len(cats)]
    app.toast(f"market filter: {state.market_filter_cat or 'ALL'}")
    app.log_action(f"mkt filter {state.market_filter_cat or 'all'}")


def h_market_add(state: TerminalState, app: App) -> None:
    """Prompt for a new ticker via omnibar (a=add mode)."""
    state.mode = "omni"
    state.omni_query = ""
    state._omni_mode = "add_ticker"
    app.toast("add ticker: type symbol, Enter to add")


def h_market_remove(state: TerminalState, app: App) -> None:
    items = _market_items(state)
    if not items or state.market_sel >= len(items):
        return
    tag, _d = items[state.market_sel]
    # default universe tickers are read-only; only user-added ones may be
    # removed (previously this popped a default's snapshot and it flickered
    # out of the table until the next poll).
    if not any(t[0] == tag for t in state.market_custom):
        app.toast(f"{tag} is a default ticker — cannot remove")
        return
    state.market_custom = [t for t in state.market_custom if t[0] != tag]
    state.market_data.pop(tag, None)
    if state.market_sel > 0:
        state.market_sel -= 1
    app.toast(f"removed {tag}")
    app.log_action(f"mkt rm {tag}")


def _ctx_sort(state: TerminalState, app: App) -> None:
    if SCREENS[state.screen]["key"] == "market":
        h_market_sort(state, app)
    else:
        h_sort(state, app)


def _ctx_filter(state: TerminalState, app: App) -> None:
    if SCREENS[state.screen]["key"] == "market":
        h_market_filter_cycle(state, app)
    elif SCREENS[state.screen]["key"] == "audit":
        h_audit_filter(state, app)
    else:
        app.toast("no filter here")


