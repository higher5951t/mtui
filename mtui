def handle_prompt(state: TerminalState, app: App, key: str) -> None:
    """Shared input handling for the command palette & global search mode."""
    if key in ("ESC", "CTRL_C"):
        state.mode = "normal"
        return
    if key == "ENTER":
        if state.results:
            state.res_idx = min(state.res_idx, len(state.results) - 1)
        if state.mode == "palette" and state.results:
            it = state.results[state.res_idx]
            if it["kind"] == "screen":
                state.screen = it["screen"]
                state.sel = state.vscroll = 0
            elif it["kind"] == "country":
                state.sel_iso = it["iso"]
                state.screen = 2
            elif it["kind"] == "action":
                app.run_job(it["title"], it["argv"])
            elif it["kind"] == "watchlist":
                state.mode = "watchlist"
                state.res_idx = 0
                return
            elif it["kind"] == "export":
                state.mode = "normal"
                h_export(state, app)
                return
            elif it["kind"] == "search":
                state.mode = "search"
                state.query = ""
                return
            app.log_action(it["label"])
            app.toast(it["label"])
            state.mode = "normal"
        elif state.mode == "search" and state.results:
            r = state.results[state.res_idx]
            if r.get("iso"):
                state.sel_iso = r["iso"]
                state.screen = 2
                if r["kind"] == "policy":
                    events = app.cache("policy_events", app.policy_events)
                    for i, e in enumerate(events):
                        if e["iso3"] == r["iso"]:
                            state.policy_sel = i
                            state.screen = 3
                            break
            state.mode = "normal"
            app.toast("open " + r["label"])
        return
    if key in ("UP", "DOWN"):
        n = len(state.results)
        if n:
            state.res_idx = (state.res_idx + (-1 if key == "UP" else 1)) % n
        return
    if key == "PGUP":
        state.res_idx = max(0, state.res_idx - 6)
        return
    if key == "PGDN":
        state.res_idx = min(len(state.results) - 1, state.res_idx + 6)
        return
    if key == "BACKSPACE":
        state.query = state.query[:-1]
        state.res_idx = 0
        return
    if len(key) == 1 and key.isprintable():
        state.query += key
        state.res_idx = 0
        return


def handle_watchlist_mode(state: TerminalState, app: App, key: str) -> None:
    iso_list = sorted(state.watch)
    if key in ("ESC", "CTRL_C"):
        state.mode = "normal"
    elif key == "ENTER" and iso_list:
        state.sel_iso = iso_list[state.res_idx]
        state.screen = 2
        state.mode = "normal"
    elif key in ("UP", "DOWN") and iso_list:
        state.res_idx = (state.res_idx + (-1 if key == "UP" else 1)) % len(iso_list)
    elif key in ("W", "w") and iso_list:
        h_toggle_watch(state, app)
        state.res_idx = min(state.res_idx, max(0, len(state.watch) - 1))
    elif key in ("F2",):
        state.mode = "normal"


def handle_help_mode(state: TerminalState, app: App, key: str) -> None:
    state.mode = "normal"


# ─────────────────────────────────────────────────────────────────────────────
# App::handle — the single routing point.
# ─────────────────────────────────────────────────────────────────────────────
def handle_key(state: TerminalState, app: App, key: Optional[str]) -> None:
    if key is None:
        return
    # VIM nav aliases only apply in non-typing modes. In the palette, search
    # and omnibar the letters j/k/g/G/J/K are real input, not movement — an
    # unconditional remap made "japan" type as "apan".
    if state.mode not in ("palette", "search", "omni"):
        key = VIM.get(key, key)
    if state.mode == "palette" or state.mode == "search":
        handle_prompt(state, app, key)
        return
    if state.mode == "watchlist":
        handle_watchlist_mode(state, app, key)
        return
    if state.mode == "omni":
        handle_omni_mode(state, app, key)
        return
    if state.mode == "help":
        handle_help_mode(state, app, key)
        return
    fn = DISPATCH.get(key)
    if fn is not None:
        fn(state, app)


