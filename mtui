    lay["top"]["A"].update(Panel(a, title=f"{iso} HEADLINE", border_style="grey30",
                                 box=box.SIMPLE, padding=(0, 1)))
    lay["top"]["B"].update(b_panel)
    lay["mid"].update(c_panel)
    lay["bot"].update(d_panel)
    return lay


# ─────────────────────────────────────────────────────────────────────────────
# Chart helpers (plotext) — the deep-dive mid pane renders the 10-year path.
# ─────────────────────────────────────────────────────────────────────────────
def _chart_fallback(macro: dict) -> RenderableType:
    """The old sparkline list — used when plotext is absent or data is thin."""
    c_lines: list[RenderableType] = []
    for mname, code, kind in MACRO_SERIES:
        pts = macro.get(code, [])
        if not pts:
            c_lines.append(Text(f" {mname:<26} — no data", style=DIM))
            continue
        last5 = pts[-5:]
        line = Text()
        line.append(f" {mname:<26}", style="white")
        line.append(sparkline8([v for _, v in last5], 8))
        line.append("  " + " ".join(f"{v:.1f}" for _, v in last5[-3:]), style="grey70")
        line.append(f"  latest {last5[-1][1]:.1f}", style="bold white")
        c_lines.append(line)
    return Panel(Group(*c_lines), title="5-YEAR MACRO TIME-SERIES — sparkline fallback",
                 border_style="grey30", box=box.SIMPLE, padding=(0, 1))


def _render_macro_chart(state: TerminalState, app: App, iso: str,
                        macro: dict, w: int, h: int) -> RenderableType:
    """10-year Debt/GDP + productivity-growth ASCII line chart.

    plotext renders into a string (we pass plotsize = the Rich pane's inner
    dims), captured and injected into a Rich Panel via Text.from_ansi so the
    plotext colors survive. Uses the stateless global API with clf/clc between
    series; a missing import or short series degrades to the sparkline list.
    """
    fallback = _chart_fallback(macro)
    try:
        import plotext as plt
    except ImportError:
        return fallback
    debt = macro.get("GGXWDG", [])
    prod = macro.get("PDB_LV", [])
    tfp = macro.get("rtfpna", [])                   # TFP index (real world)
    if len(debt) < 2 or h < 8:
        return fallback
    years = [int(y) for y, _ in debt[-10:]]
    dvals = [v for _, v in debt[-10:]]

    # growth series: prefer TFP index, else y/y % of GDP/hour; a completely
    # flat demo series is dropped so the pane shows only the informative one
    gvals: list[Optional[float]] = []
    grow_label = "TFP INDEX (rtfpna)"
    if len(tfp) >= 2:
        tv = {int(y): v for y, v in tfp}
        gvals = [tv.get(y) for y in years]
    else:
        grow_label = "PRODUCTIVITY GROWTH % y/y (PDB_LV)"
        pv = {int(y): v for y, v in prod}
        for y in years:
            v, v0 = pv.get(y), pv.get(y - 1)
            gvals.append((v - v0) / v0 * 100.0 if (v is not None and v0) else None)
    if all(v is None for v in gvals):
        gvals = []

    series = [("DEBT/GDP %", years, dvals, "yellow")]
    flat = any(v is not None for v in gvals) and         (max(g for g in gvals if g is not None) - min(g for g in gvals if g is not None)) < 1e-9
    if gvals and not flat:
        series.append((grow_label, years, gvals, "green"))
    cw = max(24, w - 8)
    # plotext emits ch+1 rows per chart; 2 border rows; keep everything in pane
    ch = max(3, (max(6, h) - 6) // len(series))
    charts: list[RenderableType] = []
    for title, xs, ys, color in series:
        plt.clf()
        plt.clc()
        plt.theme("dark")
        plt.plotsize(cw, ch)
        plt.plot(xs, ys, color=color)
        charts.append(Text.from_ansi(plt.build()))
    labels = ", ".join(t for t, _x, _y, _c in series)
    return Panel(Group(*charts),
                 title=f"10-YEAR PATH — {iso}  ({labels})",
                 border_style="grey30", box=box.SIMPLE, padding=(0, 1))


