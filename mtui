            "SELECT iso3, indicator_code, indicator_name, year FROM macro_indicators "
            "WHERE indicator_name LIKE ? OR indicator_code LIKE ? OR iso3 LIKE ? LIMIT 40",
            (pat, pat, pat)) or []:
