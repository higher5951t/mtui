def h_toggle_split(state: TerminalState, app: App) -> None:
    """F9 — toggle the 50/50 side-by-side layout. Both mirrors are seeded from
    the current screen, so the split starts as a clone you can diverge."""
    if state.layout == "hsplit":
        if state.focus == "pane2":           # park the right pane first
            snap = _pane_snap(state)
            for f, v in snap.items():
                setattr(state, f"p2_{f}", v)
        state.layout = "single"
        state.focus = "nav"
        app.toast("split OFF — single pane")
    else:
        snap = _pane_snap(state)
        for f, v in snap.items():
            setattr(state, f"p1_{f}", v)
            setattr(state, f"p2_{f}", v)
        state.layout = "hsplit"
        state.focus = "nav"
        app.toast("SPLIT ON — Tab cycles nav → left → right · 1..6 per pane")
    app.log_action(("split off" if state.layout == "single" else "split on"))


def _workspaces() -> list:
    try:
        if not WORKSPACES_PATH.exists():
            return []
        raw = json.loads(WORKSPACES_PATH.read_text())
        return raw if isinstance(raw, list) else []
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        log_error(f"workspaces load: {exc}")
        return []


def _ws_snapshot(state: TerminalState) -> dict:
    """The whole multi-pane state in a portable dict."""
    return {
        "active": {f: getattr(state, f) for f in PANE_FIELDS},
        "p1": {f: getattr(state, f"p1_{f}") for f in PANE_FIELDS},
        "p2": {f: getattr(state, f"p2_{f}") for f in PANE_FIELDS},
        "layout": state.layout,
    }


def h_workspace_save(state: TerminalState, app: App) -> None:
    """F4: save both panes + layouts + cursors to ~/.mtui/workspaces.json."""
    name = time.strftime("WS-%m%d-%H%M%S")
    ws = _workspaces()
    ws.insert(0, {"name": name, "snap": _ws_snapshot(state)})
    del ws[12:]
    try:
        WORKSPACES_PATH.parent.mkdir(parents=True, exist_ok=True)
        WORKSPACES_PATH.write_text(json.dumps(ws))
    except OSError as exc:
        log_error(f"workspace save: {exc}")
        app.toast("workspace save FAILED — see error.log")
        return
    state.workspace_idx = 0
    app.toast(f"workspace saved · {name}  (F3 cycles)")
    app.log_action(f"save ws {name}")


def h_workspace_cycle(state: TerminalState, app: App) -> None:
    """F3: load the next saved workspace (rotating)."""
    ws = _workspaces()
    if not ws:
        app.toast("no workspaces yet — F4 saves one")
        return
    state.workspace_idx = (max(0, state.workspace_idx) + 1) % len(ws)
    snap = ws[state.workspace_idx]["snap"]
    for f in PANE_FIELDS:
        setattr(state, f, snap["active"][f])
        setattr(state, f"p1_{f}", snap["p1"][f])
        setattr(state, f"p2_{f}", snap["p2"][f])
    state.layout = snap["layout"]
    state.focus = "nav"
    app.toast(f"loaded workspace {ws[state.workspace_idx]['name']}")
    app.log_action("load ws")


def h_heatmap(state: TerminalState, app: App) -> None:
    """H: toggle the Macro Matrix between summary and 11-module heatmap."""
    if SCREENS[state.screen]["key"] != "matrix":
        app.toast("heatmap lives on the Macro Matrix screen (2)")
        return
    state.matrix_heatmap = not state.matrix_heatmap
    state.hscroll = 0
    app.toast("HEATMAP view" if state.matrix_heatmap else "SUMMARY view")
    app.log_action("heatmap" if state.matrix_heatmap else "summary")


def h_omni_focus(state: TerminalState, app: App) -> None:
    """Spacebar: focus the OMNIBAR (bottom line)."""
    state.mode = "omni"
    state.omni_query = ""
    state._omni_mode = ""  # plain focus: no contextual mode


def _omni_exec(state: TerminalState, app: App) -> None:
    """Bloomberg-style jump: ISO → dive; function code → screen; macro
    indicator code → cross-country search; ticker → live quote toast."""
    q = state.omni_query.strip().upper()
    state.mode = "normal"
    if state._omni_mode == "add_ticker":
        # live-markets "add custom ticker" flow (key 'a' on market screen)
        state._omni_mode = ""
        if not q:
            app.toast("add ticker cancelled")
            return
        for _tag, sym, _lbl, _cat in TICKERS:
            if _tag == q or sym == q:
                app.toast(f"{q} is already in the default universe")
                return
        if any(t[0] == q for t in state.market_custom):
            app.toast(f"{q} is already on the watch list")
            return
        state.market_custom.append((q, q, q, "CUSTOM"))
        state.market_sel = 0
        app.toast(f"added {q} to Live Markets")
        app.log_action(f"mkt add {q}")
        return
    if not q:
        return
    # 1) exact ISO → deep-dive
    iso3 = {d["iso"] for d in app.cache("matrix", app.matrix_data)}
    if q in iso3:
        state.sel_iso = q
        state.screen = 2
        app.toast(f"jump {q}")
        app.log_action(f"omni {q}")
        return
    # 2) function code (MAT / DIV / AUD / SYS …)
    if q in FUNC_CODES:
        state.screen = FUNC_CODES[q]
        state.sel = 0
        app.toast(f"screen {SCREENS[state.screen]['name']}")
        app.log_action(f"omni {q}")
        return
    # 3) macro indicator code → global search across all countries
    if q in {c for _n, c, _k in MACRO_SERIES}:
        state.mode = "search"
        state.query = q
        app.toast(f"macro indicator {q} — all countries")
        return
    # 4) plausible ticker (alphanumeric 1-6 chars) → live quote via yahoo
    if q.isalnum() and len(q) <= 6:
        app.fetch_quote(q)
        app.toast(f"fetching {q}…")
        return
    app.toast(f"unknown omnibar token: {q}")


def handle_omni_mode(state: TerminalState, app: App, key: str) -> None:
    if key in ("ESC", "CTRL_C"):
        state.mode = "normal"
    elif key == "ENTER":
        _omni_exec(state, app)
    elif key == "BACKSPACE":
        state.omni_query = state.omni_query[:-1]
    elif key in ("UP", "DOWN", "TAB"):
        return
    elif len(key) == 1 and key.isprintable():
        state.omni_query += key


def h_help(state: TerminalState, app: App) -> None:
    state.mode = "help"


def h_reset_scroll(state: TerminalState, app: App) -> None:
    state.sel = 0
    state.vscroll = 0
    state.hscroll = 0


