        rows = self.pool.query(PAPERTRADE_DB,
            "SELECT iso3, ticker, direction, shares, entry_price, entry_date "
            "FROM paper_positions WHERE backtest_id=? ORDER BY direction DESC, iso3",
            (bt_id,))
        return [dict(r) for r in (rows or [])]


# ─────────────────────────────────────────────────────────────────────────────
# Formatting helpers
# ─────────────────────────────────────────────────────────────────────────────
def num_or_str(v: object) -> str:
    """Format a cell value that may be REAL or TEXT (e.g. pension_system_type)."""
    if v is None:
        return "—"
    if isinstance(v, (int, float)):
        return f"{float(v):.1f}" if not (float(v) != float(v)) else "—"  # NaN guard
    return str(v)[:12]


def hum(n) -> str:
    try:
        return f"{float(n):,.0f}"
    except (TypeError, ValueError):
        return "—"


def pct(v: Optional[float], nd: int = 0) -> str:
    if v is None or v != v:          # None or NaN → em dash, never "nan%"
        return "—"
    return f"{v * 100:.{nd}f}%"


def fmt_size(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}TB"


def tier_short(tier: Optional[str]) -> str:
    return (tier or "?").split(" — ")[0] or "?"


def tier_color(tier: Optional[str]) -> str:
    t = (tier or "").upper()
    if t.startswith("AAA"):
        return "bold green"
    if t.startswith("AA"):
        return "green"
    if t.startswith("A "):
        return "bright_green"
    if t.startswith("BBB"):
        return "yellow"
    if t.startswith("BB"):
        return "bright_yellow"
    if t.startswith("B "):
        return "bright_red"
    if t.startswith("CCC"):
        return "bold red"
    return "white"


def tier_sort(tier: Optional[str]) -> int:
    return {"AAA": 1, "AA": 2, "A": 3, "BBB": 4, "BB": 5, "B": 6, "CCC": 7}.get(
        tier_short(tier), 9)


def score_cell(v: Optional[float]) -> Text:
    """GFCR capacity cell — green/amber/red by the 70/40 bands."""
    if v is None or v != v:          # NaN scores from the pipeline render as —
        return Text("—", style=DIM)
    color = GREEN if v >= SCORE_OK else (YELLOW if v >= SCORE_WARN else RED)
    return Text(f"{v:.1f}", style=color)


def risk_cell(v: Optional[float], nd: int = 0) -> Text:
    """Risk-form 0-1 cell — red = high vulnerability, green = low risk."""
    if v is None or v != v:          # NaN module risk renders as —
        return Text("—", style=DIM)
    color = GREEN if v < RISK_OK else (YELLOW if v < RISK_WARN else RED)
    return Text(pct(v, nd), style=color)


def sparkline8(vals: list[float], width: int = 7) -> Text:
    """ASCII micro-chart ▁▂▃▄▅▆▇█ over the observed range (Bloomberg spark)."""
    vals = [v for v in vals if v == v]      # NaN never renders: drop NaN samples
    if not vals:
        return Text("·" * width, style=DIM)
    if len(vals) == 1:                     # only one rating round so far
        return Text("·" * width, style=DIM)
    lo, hi = min(vals), max(vals)
    if hi - lo < 1e-9:
        return Text("▄" * width, style=CYAN)
    step = (hi - lo) / (len(SPARK_CHARS) - 1)
    window = vals[-width:]
    out = "".join(SPARK_CHARS[min(len(SPARK_CHARS) - 1,
                                  int((v - lo) / step))] for v in window)
    return Text(out, style=CYAN)


def risk_bar(v: Optional[float], width: int = 10) -> Text:
    """Mini risk bar 0-100% — fills red/yellow/green by severity."""
    v = 0.0 if v is None else max(0.0, min(1.0, float(v)))
    filled = int(round(v * width))
    color = GREEN if v < RISK_OK else (YELLOW if v < RISK_WARN else RED)
    return Text("█" * filled + "░" * (width - filled), style=color)


def ci_bar(p05: float, p50: float, p95: float, width: int = 16) -> Text:
    """Uncertainty interval strip: ├───●───┤ style (p05 · p50 · p95)."""
    if (p05 is None or p50 is None or p95 is None
            or p05 != p05 or p50 != p50 or p95 != p95   # NaN guard: int(NaN) crashes
            or p95 <= p05):
        return Text("—", style=DIM)
    lo, hi = min(p05, p95), max(p05, p95)
    rng = max(1e-9, hi - lo)
    a = max(0, min(width - 1, int((p05 - lo) / rng * (width - 1))))
    b = max(0, min(width - 1, int((p50 - lo) / rng * (width - 1))))
    c = max(0, min(width - 1, int((p95 - lo) / rng * (width - 1))))
    cells = ["░"] * width
    cells[a], cells[c] = "┃", "┃"
    cells[b] = "●"
    t = Text("".join(cells), style=CYAN)
    return t


def col_window(cols: list, hscroll: int, avail: int) -> tuple[int, int]:
    """Pick the contiguous run of columns that fits `avail`, honouring hscroll."""
    n = len(cols)
    if n == 0:
        return 0, 0
    widths = [w + 2 for (_h, w, _f) in cols]
    k, acc = 0, 0
    while k < n and acc + widths[k] <= avail:
        acc += widths[k]
        k += 1
    k = max(1, k)
    max_start = max(0, n - k)
    start = max(0, min(hscroll, max_start))
    return start, min(n, start + k)


def pad_pair(left: Text, right: Text, width: int) -> Text:
    """Line with both sides justified to `width` (Bloomberg header style).
    If the pair overflows, the left side is trimmed so the right (status)
    side never wraps on narrow terminals."""
    overflow = width - len(left.plain) - len(right.plain)
    pad = max(1, overflow)
    if overflow < 1:                       # trim left so status never wraps
        keep = max(0, width - len(right.plain) - 1)
        if keep < len(left.plain):
            left = left[:keep]
    out = Text()
    out.append_text(left)
    out.append(" " * pad)
    out.append_text(right)
    return out

