    a.add_row(Text(f"TIER  {tier}", style=tier_color(tier)))
    ci = [0.0 if (x is None or x != x) else x for x in (p05, p50, p95)]
    a.add_row(ci_bar(*ci))
    a.add_row(Text(f"90% CI  {p05:.1f} ─ {p50:.1f} ─ {p95:.1f}" if p05 is not None and p05 == p05
                   else "90% CI —", style=DIM))
    a.add_row(Text(f"ROUND {rating.get('year') or '—'} · PEER {rating.get('peer_group') or '—'} · "
                   f"S_eff {rating.get('s_eff'):.3f}" if rating.get("s_eff") is not None
                   else f"ROUND {rating.get('year') or '—'}", style=DIM))
    g, d_ = rating.get("johnson_su_gamma"), rating.get("johnson_su_delta")
    a.add_row(Text(f"Johnson SU  γ={g:.2f} δ={d_:.2f}" if g is not None and d_ is not None
                   else "", style="grey35"))

    # ── Pane B: 11-module breakdown ─────────────────────────────────────
    b_rows: list[RenderableType] = []
    for mname, col, weight in GFCR_MODULES:
        v = rating.get(col)
        if v is None:
            continue
        line = Text()
        line.append(f" {mname:<24}", style="white")
        line.append(risk_bar(v, 8))
        line.append(f" {pct(v)}", style=risk_cell(v).style)
        if weight:
            line.append(f" w{weight:.2f}", style=DIM)
        b_rows.append(line)
    b_panel = Panel(Group(*b_rows), title=f"11-MODULE BREAKDOWN — {iso}",
                    border_style="grey30", box=box.SIMPLE, padding=(0, 1))

    # ── Pane C: 10-year trajectory — plotext ASCII chart ──────────────
    # (falls back to one-line sparklines when plotext is missing / thin data)
    mid_h = max(6, h * 3 // 9)             # mid pane height, needed by the chart
    c_panel = _render_macro_chart(state, app, iso, macro, w, mid_h)

    # ── Pane D: AI narrative ────────────────────────────────────────────
    if narr:
        d_body = Text(narr, style="grey75")
