def h_screen(state: TerminalState, app: App, idx: int) -> None:
    state.screen = idx % len(SCREENS)
    state.sel = 0
    state.vscroll = 0
    state.hscroll = 0


def h_sort(state: TerminalState, app: App) -> None:
    state.sort_key = SORT_KEYS[(SORT_KEYS.index(state.sort_key) + 1) % len(SORT_KEYS)]
    state.sort_asc = False
    app.log_action(f"sort {state.sort_key}")


def h_sort_flip(state: TerminalState, app: App) -> None:
    state.sort_asc = not state.sort_asc
    app.log_action(f"sort {state.sort_key} {'asc' if state.sort_asc else 'desc'}")


def h_toggle_watch(state: TerminalState, app: App) -> None:
    key = SCREENS[state.screen]["key"]
    iso = None
    if key == "matrix" and state.order:
        iso = state.order[state.sel]
    elif key == "country":
        iso = state.sel_iso
    elif state.mode == "watchlist" and state.res_idx < len(sorted(state.watch)):
        iso = sorted(state.watch)[state.res_idx]
    if iso:
        if iso in state.watch:
            state.watch.discard(iso)
            app.toast(f"★ unpinned {iso}")
        else:
            state.watch.add(iso)
            app.toast(f"★ pinned {iso}")
        app.save_watchlist()


def h_audit_filter(state: TerminalState, app: App) -> None:
    state.audit_imputed_only = not state.audit_imputed_only
    app.bump()
    app.toast("audit filter: " + ("ESTIMATED/missing ONLY" if state.audit_imputed_only else "ALL"))


def h_export(state: TerminalState, app: App) -> None:
    key = SCREENS[state.screen]["key"]
    ts = time.strftime("%Y%m%d-%H%M%S")
    rows = []
    if key == "matrix":
        data = app.cache("matrix", app.matrix_data)
        rows = [("iso3", "country", "score", "tier", "s_eff", "fiscal", "ext", "dyn"),
                *[(d["iso"], d["name"], d["gfcr_score"], d["gfcr_tier"], d["s_eff"],
                   d["fiscal_stress"], d["external_vulnerability"], d["dynamical_stress"])
                  for d in data]]
    elif key == "audit":
        rows = [("iso3", "year", "indicator", "source", "flag", "raw", "final"),
                *[(d["iso"], d["year"], d["indicator"], d["source"],
                   d["imputation_flag"], d["raw_value"], d["final_value"])
                  for d in app.cache(f"audit_{state.audit_imputed_only}",
                                     lambda: app.audit_rows(state.audit_imputed_only))]]
    elif key == "policy":
        events = app.cache("policy_events", app.policy_events)
        rows = [("iso3", "event_date", "type", "description"),
                *[(e["iso3"], e["event_date"], e["event_type"], e["description"])
                  for e in events]]
    elif key == "dashboard":
        data = app.cache("matrix", app.matrix_data)
        rows = [("iso3", "gfcr_score", "tier"), *[(d["iso"], d["gfcr_score"],
                                                   d["gfcr_tier"]) for d in data]]
    if not rows:
        app.toast("nothing to export here")
        return
    path = EXPORT_DIR / f"{key}_{ts}.csv"
    try:
        with open(path, "w", newline="", encoding="utf-8") as fh:
            csv.writer(fh).writerows(rows)
    except OSError as exc:
        log_error(f"export: {exc}")
        app.toast("export failed — see error.log")
        return
    # one copy call only: a second `copy_clipboard("")` probe would overwrite
    # the clipboard with an empty string and lose the export we just made
    copied = copy_clipboard(path.read_bytes())
    msg = f"exported {len(rows) - 1} rows → {path.name}"
    if copied:
        msg += " · clipboard"
    app.toast(msg)
    app.log_action(f"export {key}")


def copy_clipboard(text: str | bytes) -> bool:
    for tool in (["xclip", "-selection", "clipboard"], ["wl-copy"],
                 ["xsel", "--clipboard", "--input"], ["pbcopy"]):
        if not shutil.which(tool[0]):
            continue
        try:
            p = subprocess.Popen(tool, stdin=subprocess.PIPE,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            data = text if isinstance(text, bytes) else text.encode("utf-8")
            p.communicate(data, timeout=8)
            return p.returncode == 0     # 0 = the tool really accepted the text
        except Exception:
            continue
    return False


def _copy_code() -> int:
    """`mtui --code`: copy mtui's own full source to the clipboard.

    Reads the script itself (including any new code), pushes it through the
    first working clipboard tool, then — when a matching read-back tool is
    installed — pastes it back and compares byte-for-byte so a truncated or
    mangled copy is reported as an error instead of silently succeeding.
    """
    src = Path(__file__).resolve()
    if not src.exists():
        print(f"mtui --code: cannot find source at {src}", file=sys.stderr)
        return 1
    code = src.read_text(encoding="utf-8")
    payload = code.encode("utf-8")
    sha = hashlib.sha256(payload).hexdigest()
    n_lines = code.count("\n") + 1

    if not copy_clipboard(code):
        print("mtui --code: no clipboard tool found (need xclip/wl-copy/xsel/pbcopy)",
              file=sys.stderr)
        return 1

    print(f"mtui --code: copied {src} to clipboard")
    print(f"  {n_lines} lines · {len(payload):,} bytes · sha256 {sha[:16]}…")

    return _verify_paste(payload, n_lines)


def _verify_paste(payload: bytes, n_lines: int) -> int:
    """Round-trip clipboard check. Paste the just-copied payload back with the
    same clipboard family and compare byte-for-byte so a truncated or mangled
    copy is reported as an error instead of silently succeeding."""
    readback: list[str] | None = None
    for tool in ([["wl-paste", "--no-newline"], ["wl-copy"]],
                 [["xclip", "-selection", "clipboard", "-o"], ["xclip"]],
                 [["xsel", "--clipboard", "--output"], ["xsel"]],
                 [["pbpaste"], ["pbcopy"]]):
        if shutil.which(tool[1][0]):          # we copied with this family
            if shutil.which(tool[0][0]):      # its read-back tool exists
                readback = tool[0]
            break
    if readback is None:
        print("  ✓ copied (no read-back tool installed — paste to verify safely)")
        return 0
    try:
        p = subprocess.Popen(readback, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        got = p.communicate(timeout=8)[0].replace(b"\r\n", b"\n").replace(b"\r", b"\n")
    except Exception as exc:
        print(f"  ? read-back unavailable ({exc}) — paste to verify", file=sys.stderr)
        return 0
    # a trailing newline is often added/kept by clipboard tools — normalize it
    got_n = got.rstrip(b"\n")
    want_n = payload.rstrip(b"\n")
    if got_n == want_n:
        print(f"  ✓ verified: read back {len(got):,} bytes — ALL {n_lines} lines intact")
        return 0
    if not got:
        print("  ✗ copy FAILED: nothing landed in the clipboard"
              " (tool exited 0 but no data available).", file=sys.stderr)
    else:
        print("  ✗ MISMATCH: copied text differs from the source!"
              f" (sent {len(payload):,} b, got {len(got):,} b)", file=sys.stderr)
    return 1


def _code_sections(src: str) -> list[tuple[int, int, str]]:
    """Top-level source sections as 0-based (start, end_exclusive) line slices
    with a human title, for `mtui --code copy secN`.

    A section boundary is a full-width banner header block
    (`# ────…` + comment title + `# ────…`); the whole block belongs to the
    following section and a bare closing banner stays with the preceding one.
    A header block nested inside the previous block's banner pair (stacked
    comment headers) merges into that section instead of splitting it.
    The first open boundary anchors the rest, so every source line from there
    to EOF lands in exactly one section (concat(sections) == that tail)."""
    lines = src.splitlines()

    def is_banner(i: int) -> bool:
        s = lines[i].strip()
        return len(s) >= 50 and set(s) <= {"#", " ", "─"}

    def next_content(i: int) -> int:
        j = i + 1
        while j < len(lines) and (not lines[j].strip() or is_banner(j)):
            j += 1
        return j

    def block_end(o: int) -> Optional[int]:
        """First closing banner after open o, i.e. a banner whose next content
        line is code (the close of o's header block)."""
        for j in range(o + 1, len(lines)):
            if not is_banner(j):
                continue
            nxt = next_content(j)
            if nxt < len(lines) and not lines[nxt].lstrip().startswith("#"):
                return j
        return None

    opens: list[int] = []
    for i in range(len(lines)):
        if not is_banner(i):
            continue
        nxt = next_content(i)
        if nxt < len(lines) and lines[nxt].lstrip().startswith("#"):
            if not opens or i > (block_end(opens[-1]) or -1):
                opens.append(i)
    if not opens:
        opens = [0]

    ends = opens[1:] + [len(lines)]
    secs: list[tuple[int, int, str]] = []
    for a, b in zip(opens, ends):
        title = ""
        for l in lines[a + 1:b]:
            s = l.strip()
            if not s:
                continue
            if s.startswith("#") and not (len(s) >= 50 and set(s) <= {"#", " ", "─"}):
                title = s.lstrip("# ").rstrip(".")
            else:
                title = title or s[:68]
            break
        secs.append((a, b, title))
    return secs


def _parse_section_token(tok: str) -> Optional[int]:
    """'sec1' / 'SEC1' / '1' → 1; anything else → None."""
    t = tok.lower()
    while t.startswith("sec"):
        t = t[3:]
    return int(t) if t.isdigit() else None


def _section_list() -> int:
    """`mtui --code copy list`: print the section table without copying."""
    src = Path(__file__).resolve()
    code = src.read_text(encoding="utf-8")
    secs = _code_sections(code)
    print(f"mtui --code: {len(secs)} top-level sections in {src} (use sec1..sec{len(secs)}):")
    for i, (a, b, title) in enumerate(secs, 1):
        print(f"    sec{i:<3} lines {a + 1:>4}-{b:<4} {title}")
    return 0


def _copy_section(n: int) -> int:
    """`mtui --code copy secN`: copy one top-level source section to the
    clipboard — banner header, code, and all — with the same hash + round-trip
    verification as the full-file copy."""
    src = Path(__file__).resolve()
    if not src.exists():
        print(f"mtui --code: cannot find source at {src}", file=sys.stderr)
        return 1
    code = src.read_text(encoding="utf-8")
    secs = _code_sections(code)
    if not 1 <= n <= len(secs):
        print(f"mtui --code: section {n} out of range — {len(secs)} sections "
              f"available (sec1..sec{len(secs)}):", file=sys.stderr)
        for i, (a, b, title) in enumerate(secs, 1):
            print(f"    sec{i:<3} lines {a + 1:>4}-{b:<4} {title}", file=sys.stderr)
        return 2
    a, b, title = secs[n - 1]
    block = "\n".join(code.splitlines()[a:b]).rstrip("\n") + "\n"
    payload = block.encode("utf-8")
    sha = hashlib.sha256(payload).hexdigest()
    n_lines = block.count("\n") + 1

    if not copy_clipboard(block):
        print("mtui --code: no clipboard tool found (need xclip/wl-copy/xsel/pbcopy)",
              file=sys.stderr)
        return 1

    print(f"mtui --code: copied section {n}/{len(secs)} to clipboard — {title}")
    print(f"  {n_lines} lines · {len(payload):,} bytes · sha256 {sha[:16]}…")
    return _verify_paste(payload, n_lines)


