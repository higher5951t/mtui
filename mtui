def render_matrix(state: TerminalState, app: App, w: int, h: int) -> RenderableType:
    data = app.cache("matrix", app.matrix_data)
    key, asc = state.sort_key, state.sort_asc

    def sortfn(d: dict):
        if key == "country":
            return (d["name"] or "").lower()
        if key == "tier":
            return tier_sort(d["gfcr_tier"])
        if key == "fisc":
            return d["fiscal_stress"] if d["fiscal_stress"] is not None else 1e9
        if key == "ext":
            return d["external_vulnerability"] if d["external_vulnerability"] is not None else 1e9
        if key == "dyn":
            return d["dynamical_stress"] if d["dynamical_stress"] is not None else 1e9
        return d["gfcr_score"] if d["gfcr_score"] is not None else -1

    rows = sorted(data, key=sortfn, reverse=not asc)
    state.order = [d["iso"] for d in rows]          # shared with ENTER handler
    if state.sel >= len(rows):
        state.sel = 0

    cols = [
        ("★", 1, lambda d: Text("★" if d["iso"] in state.watch else "·",
                                style="yellow" if d["iso"] in state.watch else "grey30")),
        ("ISO", 5, lambda d: Text(d["iso"], style="bold cyan")),
        ("COUNTRY", 14, lambda d: Text((d["name"] or "")[:14], style=TXT)),
        ("SCORE", 7, lambda d: score_cell(d["gfcr_score"])),
        ("TIER", 4, lambda d: Text(tier_short(d["gfcr_tier"]),
                                   style=tier_color(d["gfcr_tier"]))),
        ("S_EFF", 6, lambda d: Text(
            f"{d['s_eff']:.2f}" if d["s_eff"] is not None else "—",
            style=("bright_green" if d["s_eff"] < RISK_OK
                   else ("yellow" if d["s_eff"] < RISK_WARN else "bright_red"))
            if d["s_eff"] is not None else DIM)),
        ("FISC", 5, lambda d: risk_cell(d["fiscal_stress"])),
        ("EXT", 5, lambda d: risk_cell(d["external_vulnerability"])),
        ("DYN", 5, lambda d: risk_cell(d["dynamical_stress"])),
        ("TREND3Y", 8, lambda d: sparkline8(d["trend"])),
        ("PEER", 9, lambda d: Text(d["peer_group"] or "—", style=DIM)),
    ]
    arrow = "▾" if not asc else "▴"
    sub = f"SORT {SORT_LABEL[key].upper()} {arrow}  [s] cycle · [S] flip · Enter = deep-dive"
    return render_grid(state, app, "MACRO MATRIX — GLOBAL SOVEREIGN CAPACITY · GFCR v6.0",
                       cols, rows, h, sel=state.sel, subtitle=sub)


