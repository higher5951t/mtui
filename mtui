# ─────────────────────────────────────────────────────────────────────────────
# Screen assembly & drawing
# ─────────────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────
# Split-pane machinery. PANE_FIELDS are mirrored as p1_*/p2_* on TerminalState;
# the live fields always hold the *focused* pane, so every existing handler and
# renderer keeps working untouched. activate_pane() swaps mirrors on focus
# changes; _pane_render() draws either side from its mirror for build_screen.
# ─────────────────────────────────────────────────────────────────────────────
def _pane_snap(state: TerminalState) -> dict:
    return {f: getattr(state, f) for f in PANE_FIELDS}


def _pane_restore(state: TerminalState, snap: dict) -> None:
    for f, v in snap.items():
        setattr(state, f, v)


def activate_pane(state: TerminalState, target: int) -> None:
    """Materialize pane `target` (1|2) into the live fields, parking the
    outgoing pane in its mirror. Focus tokens: nav/content live on pane 1,
    "pane2" focus lives on pane 2."""
    if state.layout != "hsplit":
        return
    cur = 1 if state.focus in ("nav", "content") else 2
    if cur == target:
        return
    snap = _pane_snap(state)                        # park outgoing pane
    for f, v in snap.items():
        setattr(state, f"p{cur}_{f}", v)
    for f in PANE_FIELDS:                           # load incoming pane
        setattr(state, f, getattr(state, f"p{target}_{f}"))


def _pane_render(state: TerminalState, app: App, pane: int,
                 w: int, h: int) -> RenderableType:
    """Render one split pane from its mirror, leaving the live state intact.
    The focused side gets the bright-cyan border + row highlight; the other
    side renders inert (focus "inert" suppresses selection highlighting)."""
    saved_focus = state.focus
    snap = _pane_snap(state)
    for f in PANE_FIELDS:
        setattr(state, f, getattr(state, f"p{pane}_{f}"))
    focused = (pane == 1 and state.focus != "pane2") or               (pane == 2 and state.focus == "pane2")
    state.focus = "content" if focused else "inert"
    try:
        body = content_renderable(state, app, w, h)
    finally:
        state.focus = saved_focus
        _pane_restore(state, snap)
    return Panel(body, box=box.SQUARE,
                 border_style="bright_cyan" if focused else "grey30",
                 padding=(0, 0))


def heat_bg(v: Optional[float]) -> str:
    """Risk → background colour ramp: 0.0 bright green … 1.0 bright red."""
    if v is None or v != v:           # NaN/None → plain cell
        return ""
    if v < 0.15:
        return "on bright_green"
    if v < 0.40:
        return "on green"
    if v < 0.60:
        return "on yellow"
    return "on bright_red"


def render_matrix_heatmap(state: TerminalState, app: App, w: int, h: int) -> RenderableType:
    """H-view: 40 countries × 11 GFCR modules — every cell is the module risk
    (0-100%) painted on a green→red background. `<` `>` scroll the module
    window horizontally (reusing the h_hscroll machinery); edge-to-edge table,
    zero wasted padding."""
    data = app.cache("heatmap", app.heatmap_data)
    rows = sorted(data, key=lambda d: (d["name"] or "").lower())
    state.order = [d["iso"] for d in rows]          # ENTER dives the right iso
    if state.sel >= len(rows):
        state.sel = 0
    modules = GFCR_MODULES
    inner = max(2, h - 3)
    total = len(rows)
    voff = max(0, min(state.vscroll, max(0, total - inner)))
    vis = rows[voff:voff + inner]

    # column budget: ISO + COUNTRY + as many 5-char cells as fit (no padding)
    fixed = 5 + 13
    cell_w = 5
    per_page = max(1, (max(10, w) - fixed - 4) // (cell_w + 1))
    offs = min(state.hscroll, max(0, len(modules) - per_page))
    page = modules[offs:offs + per_page]

    t = Table(box=None, expand=True, pad_edge=False, show_header=True,
              header_style="bold yellow", padding=(0, 0))
    t.add_column("ISO", width=5, no_wrap=True)
    t.add_column("COUNTRY", width=13, no_wrap=True)
    for mname, col, _wgt in page:
        t.add_column(mname.split()[0][:5].upper(), width=cell_w,
                     no_wrap=True, justify="center")
    for i, d in enumerate(vis):
        abs_i = voff + i
        sel_here = abs_i == state.sel and state.focus == "content"
        cells = [Text(("▸ " if sel_here else "  ") + d["iso"],
                      style="bold black on bright_cyan" if sel_here else "bold cyan"),
                 Text((d["name"] or "")[:13], style=TXT)]
        for _mname, col, _w in page:
            v = d.get(col)
            if v is None or v != v:   # NaN module risk renders as a dot, not "nan"
                cells.append(Text("·", style="grey30"))
                continue
            style = "black on bright_cyan" if sel_here else f"black {heat_bg(v)}"
            cells.append(Text(f"{v * 100:3.0f}", style=style, justify="center"))
        t.add_row(*cells)

    sub = f"HEATMAP · {total} countries × {len(modules)} modules"
    sub += f"   rows {voff + 1}-{min(voff + inner, total)}/{total}"
    if offs + per_page < len(modules):
        sub += (f"   modules {offs + 1}-{min(offs + per_page, len(modules))}"
                f"/{len(modules)}  < >")
    leg = Text(" 0% ", style=f"black {heat_bg(0.05)}")
    leg.append(" 25% ", style=f"black {heat_bg(0.25)}")
    leg.append(" 50% ", style=f"black {heat_bg(0.5)}")
    leg.append(" 80%+ ", style=f"black {heat_bg(0.8)}")
    return Panel(Group(t, Text(sub, style=DIM), leg),
                 title="GFCR v6.0 — 11-MODULE RISK HEATMAP  (H toggles)",
                 border_style="grey30", box=box.SIMPLE, padding=(0, 0))


def content_renderable(state: TerminalState, app: App, w: int, h: int) -> RenderableType:
    app.content_w = max(20, w - 8)   # usable grid width (borders/padding)
    if state.mode == "palette":
        return render_palette(state, app, h)
    if state.mode == "search":
        return render_search(state, app, h)
    if state.mode == "watchlist":
        return render_watchlist(state, app, h)
    if state.mode == "help":
        return render_help(state, app, h)
    key = SCREENS[state.screen]["key"]
    if key == "dashboard":
        return render_dashboard(state, app, w, h)
    if key == "matrix":
        if state.matrix_heatmap:
            return render_matrix_heatmap(state, app, w, h)
        return render_matrix(state, app, w, h)
    if key == "country":
        return render_country(state, app, w, h)
    if key == "policy":
        return render_policy(state, app, w, h)
    if key == "audit":
        return render_audit(state, app, w, h)
    if key == "system":
        return render_system(state, app, w, h)
    if key == "market":
        return render_market(state, app, w, h)
    if key == "papertrade":
        return render_papertrade(state, app, w, h)
    return Text("")


def build_screen(state: TerminalState, app: App, cols: int, lines: int) -> Layout:
    """Dynamic layout, always full-size:
        line 0      live ticker tape (marquee)
        lines 1-2   header band
        body        nav rail + content  (content halves in hsplit mode)
        last 4      command line · status · hints · OMNIBAR
    """
    root = Layout()
    root.split_column(
        Layout(name="tape", size=1),
        Layout(name="header", size=2),
        Layout(name="body", ratio=1),
        Layout(name="footer", size=4),
    )
    root["tape"].update(render_ticker(state, cols))
    root["header"].update(render_header(state, app, cols))
    body_h = max(4, lines - 7)                       # 1 tape + 2 header + 4 footer

    # Dynamic sidebar: expands when focused, shrinks to icons when not
    nav_w = max(28, cols // 4) if (state.nav_expanded or state.focus == "nav") else max(12, cols // 10)
    if state.layout == "hsplit":
        nav_w = max(16, cols // 6)                   # split mode keeps it mid-size
    body = root["body"]

    # modal overlays (palette/search/watchlist/help) draw full-width regardless
    overlay = state.mode in ("palette", "search", "watchlist", "help")
    if state.layout == "hsplit" and not overlay:
        body.split_row(
            Layout(name="nav", size=nav_w),
            Layout(name="split", ratio=1),
        )
        cw = max(30, cols - nav_w)
        split = body["split"]
        split.split_row(Layout(name="left", ratio=1), Layout(name="right", ratio=1))
        split["left"].update(_pane_render(state, app, 1, cw // 2, body_h))
        split["right"].update(_pane_render(state, app, 2, cw - cw // 2, body_h))
    else:
        body.split_row(
            Layout(name="nav", size=nav_w),
            Layout(name="content", ratio=1),
        )
        body["content"].update(content_renderable(state, app, cols - nav_w, body_h))
    body["nav"].update(render_nav(state, app, nav_w))
    root["footer"].update(render_footer(state, app, cols))
    return root


def draw_screen(console: Console, renderable: RenderableType) -> None:
    """Deterministic full-screen repaint: home cursor, redraw, clear below."""
    with console.capture() as cap:
        console.print(renderable, end="")
    text = cap.get()
    lines = text.split("\n")
    if len(lines) > console.height:                  # defensive clip
        lines = lines[:console.height]
    out = "\r\n".join(lines).rstrip("\r\n")
    sys.stdout.write("\x1b[H" + out + "\x1b[0J")
    sys.stdout.flush()

