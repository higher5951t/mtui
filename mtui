# Terminal control: raw mode + alternate screen
# ─────────────────────────────────────────────────────────────────────────────
class Terminal:
    def __init__(self) -> None:
        self.fd = sys.stdin.fileno()
        self._saved: Optional[list] = None
        self._active = False

    def enter(self) -> None:
        if not sys.stdin.isatty():
            raise RuntimeError("mtui needs an interactive terminal (TTY).")
        self._saved = termios.tcgetattr(self.fd)
        tty.setraw(self.fd)
        attrs = termios.tcgetattr(self.fd)
        attrs[1] |= termios.OPOST                     # \n -> \r\n
        termios.tcsetattr(self.fd, termios.TCSADRAIN, attrs)
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J\x1b[H")
        sys.stdout.flush()
        self._active = True

    def exit_temp(self) -> None:
        if self._active:
            sys.stdout.write("\x1b[?25h\x1b[?1049l")
            sys.stdout.flush()
            if self._saved is not None:
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self._saved)
            self._active = False

    def reenter(self) -> None:
        if not self._active and self._saved is not None:
            tty.setraw(self.fd)
            attrs = termios.tcgetattr(self.fd)
            attrs[1] |= termios.OPOST
            termios.tcsetattr(self.fd, termios.TCSADRAIN, attrs)
            sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J\x1b[H")
            sys.stdout.flush()
            self._active = True

    def restore(self) -> None:
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        if self._saved is not None:
            try:
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self._saved)
            except (termios.error, OSError):
                pass
        self._active = False


def read_key(timeout: float = 1.0) -> Optional[str]:
    """Read one key: arrows, F-keys, Ctrl keys, or a literal character."""
    fd = sys.stdin.fileno()
    r, _, _ = select.select([fd], [], [], timeout)
    if not r:
        return None
    try:
        ch = os.read(fd, 1).decode(errors="replace")
    except OSError:
        return None
    simple = {"A": "UP", "B": "DOWN", "C": "RIGHT", "D": "LEFT",
              "H": "HOME", "F": "END", "Z": "BTAB"}
    fn_o = {"P": "F1", "Q": "F2", "R": "F3", "S": "F4"}
    fn_dig = {"1": "HOME", "4": "END", "7": "HOME", "8": "END", "11": "F1",
              "12": "F2", "13": "F3", "14": "F4", "15": "F5", "17": "F6",
              "18": "F7", "19": "F8", "20": "F9", "21": "F10", "23": "F11", "24": "F12"}
    if ch == "\x1b":
        r2, _, _ = select.select([fd], [], [], 0.04)
        if not r2:
            return "ESC"
        ch2 = os.read(fd, 1).decode(errors="replace")
        if ch2 in ("[", "O"):
            r3, _, _ = select.select([fd], [], [], 0.04)
            if not r3:
                return "ESC"
            ch3 = os.read(fd, 1).decode(errors="replace")
            if ch2 == "[":
                if ch3 in simple:
                    return simple[ch3]
                if ch3 in ("5", "6", "3"):          # PgUp / PgDn / Del
                    r4, _, _ = select.select([fd], [], [], 0.04)
                    if r4:                          # consume the trailing "~"
                        os.read(fd, 1)
                    return {"5": "PGUP", "6": "PGDN", "3": "DEL"}[ch3]
                buf = ch3
                r4, _, _ = select.select([fd], [], [], 0.04)
                if r4:
                    buf += os.read(fd, 1).decode(errors="replace")
                return fn_dig.get(buf, "ESC")
            else:                                    # OP..S = F1..F4
                return fn_o.get(ch3, "ESC")
        if ch2.isdigit():                            # \x1b1;5C etc — consume
            digits = ch2
            end = time.monotonic() + 0.08
            while time.monotonic() < end:
                r3, _, _ = select.select([fd], [], [], 0.008)
                if not r3:
                    break
                c = os.read(fd, 1).decode(errors="replace")
                digits += c
                if c in "ABCD":
                    return simple.get(c, "ESC")
            return "ESC"
        return "ESC"
    return {
        "\r": "ENTER", "\n": "ENTER", "\t": "TAB",
        "\x7f": "BACKSPACE", "\x08": "BACKSPACE",
        "\x03": "CTRL_C", "\x06": "CTRL_F",
    }.get(ch, ch)


