def global_search(app: App, needle: str) -> list[dict]:
    pat = f"%{needle}%"
    out: list[dict] = []
    for r in app.pool.query(MAIN_DB,
            "SELECT iso3, indicator_code, indicator_name, year FROM macro_indicators "
            "WHERE indicator_name LIKE ? OR indicator_code LIKE ? OR iso3 LIKE ? LIMIT 40",
            (pat, pat, pat)) or []:
        out.append({"kind": "macro", "iso": r["iso3"],
                    "label": f"[MACRO] {r['indicator_code']} — {r['indicator_name']}",
                    "sub": f"{r['iso3']} {r['year']}"})
    for r in app.pool.query(MAIN_DB,
            "SELECT iso3, name FROM countries WHERE name LIKE ? OR iso3 LIKE ?",
            (pat, pat)) or []:
        out.append({"kind": "country", "iso": r["iso3"],
                    "label": f"[CTY] {r['iso3']} — {r['name']}", "sub": "country"})
    for r in app.pool.query(MAIN_DB,
            "SELECT iso3, event_date, description FROM policy_events "
            "WHERE description LIKE ? LIMIT 20", (pat,)) or []:
        out.append({"kind": "policy", "iso": r["iso3"],
                    "label": f"[POLICY] {r['iso3']} {r['event_date']}",
                    "sub": (r["description"] or "")[:80]})
    for r in app.pool.query(MAIN_DB,
            "SELECT iso3, indicator, source, imputation_flag FROM data_audit "
            "WHERE indicator LIKE ? OR source LIKE ? LIMIT 30", (pat, pat)) or []:
        out.append({"kind": "audit", "iso": r["iso3"],
                    "label": f"[AUDIT] {r['indicator']}",
                    "sub": f"{r['iso3']} · {r['source']} · {r['imputation_flag']}"})
    for r in app.pool.query(GFCR_DB,
            "SELECT iso3, gfcr_tier, gfcr_score FROM country_ratings_gfcr "
            "WHERE gfcr_tier LIKE ? OR iso3 LIKE ? LIMIT 20", (pat, pat)) or []:
        out.append({"kind": "rating", "iso": r["iso3"],
                    "label": f"[GFCR] {r['iso3']} {r['gfcr_score']} {r['gfcr_tier']}",
                    "sub": "sovereign rating"})
    return out[:60]


