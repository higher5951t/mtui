def _policy_has_data(app: App, ev: dict) -> bool:
    """True if any macro series exists within the ±5y impact window."""
    year = int(str(ev["event_date"])[:4])
    for _name, code, _kind in MACRO_SERIES:
        pts = app.macro_series(ev["iso3"]).get(code, [])
        if any(year - 5 <= y <= year + 4 for y, _v in pts):
            return True
    return False


def render_policy(state: TerminalState, app: App, w: int, h: int) -> RenderableType:
    events = app.cache("policy_events", app.policy_events)
    if not events:
        return Panel(Text("No policy events in DB (policy_events table empty).",
                          style=DIM), border_style="grey30")
    # Auto-select the most recent reform that actually has ±5y macro data
    # (demo data spans 2016-2026, so older events would show "no data").
    if state.policy_sel >= len(events) or not _policy_has_data(app, events[state.policy_sel]):
        for i, e in enumerate(events):
            if _policy_has_data(app, e):
                state.policy_sel = i
                break
        else:
            state.policy_sel = 0

    ev = events[state.policy_sel]
    year = int(str(ev["event_date"])[:4])
    impact = app.cache(f"impact_{ev['iso3']}_{year}",
                       lambda: app.policy_impact(ev["iso3"], year))

    # ── left: dense one-line-per-reform event feed (scrollable) ────────
    inner = max(3, h - 3)
    total = len(events)
    voff = max(0, min(state.vscroll, max(0, total - inner)))
    vis = events[voff:voff + inner]
    t = Table(box=box.SIMPLE, expand=True, show_header=True, header_style="bold yellow",
              padding=(0, 1))
    t.add_column("ISO", width=5, no_wrap=True)
    t.add_column("DATE", width=10, no_wrap=True)
    t.add_column("TYPE", width=13, no_wrap=True)
    t.add_column("REFORM", ratio=1, no_wrap=True, overflow="ellipsis")
    for i, e in enumerate(vis):
        abs_i = voff + i
        if abs_i == state.policy_sel and state.focus == "content":
            cells = [Text(x, style="bold black on bright_cyan") for x in
                     (e["iso3"], str(e["event_date"])[:10], (e["event_type"] or ""),
                      (e["description"] or ""))]
        else:
            cells = [Text(e["iso3"], style="bold cyan"),
                     Text(str(e["event_date"])[:10], style=DIM),
                     Text(e["event_type"] or "—", style=YELLOW),
                     Text(e["description"] or "", style=TXT)]
        t.add_row(*cells)
    left_panel = Panel(t, title=f"POLICY EVENTS ({total}) — ↑↓ select",
                       subtitle=f"{voff + 1}-{min(voff + inner, total)}/{total}",
                       subtitle_align="right", border_style="grey30",
                       box=box.SIMPLE, padding=(0, 0))

    # ── right: compact one-line impact deltas (5y before vs after) ─────
    imp_lines: list[RenderableType] = []
    for mname, b, a_, delta in impact:
        label = Text(f" {mname:<24}", style="white")
        if b is None and a_ is None:
            imp_lines.append(label + Text("  no data", style=DIM))
            continue
        before = f"{b:.1f}" if b is not None else "—"
        after = f"{a_:.1f}" if a_ is not None else "—"
        if delta is None:
            dcell = Text(" Δ—", style=DIM)
        else:
            better = (delta < 0) if mname.split(" ")[0] in BETTER_DOWN else (delta > 0)
            dcell = Text(f" Δ{delta:+.1f}", style=GREEN if better else RED)
        imp_lines.append(label + Text(f" {before} → {after}", style="grey70") + dcell)
    right_panel = Panel(Group(*imp_lines),
                        title=f"IMPACT {ev['iso3']} · {year}±5Y",
                        border_style="grey30", box=box.SIMPLE, padding=(0, 1))

    # ── bottom: full description of the selected reform ────────────────
    desc = Text(f" {ev['iso3']} {ev['event_date']} — {ev['event_type']}: "
                f"{ev['description']}", style="grey75")
    if ev.get("source_url"):
        desc.append(f"   [{ev['source_url'][:70]}]", style=DIM)
    desc_panel = Panel(desc, title="REFORM DETAIL", border_style="grey30",
                       box=box.SIMPLE, padding=(0, 1))

    lay = Layout()
    lay.split_row(Layout(name="left", ratio=3), Layout(name="right", ratio=2))
    lay["left"].update(left_panel)
    lay["right"].update(right_panel)
    outer = Layout()
    outer.split_column(Layout(name="main", ratio=1), Layout(name="desc", size=4))
    outer["main"].update(lay)
    outer["desc"].update(desc_panel)
    return outer
