# ─────────────────────────────────────────────────────────────────────────────
# Screen assembly & drawing
# ─────────────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────
# Split-pane machinery. PANE_FIELDS are mirrored as p1_*/p2_* on TerminalState;
# the live fields always hold the *focused* pane, so every existing handler and
# renderer keeps working untouched. activate_pane() swaps mirrors on focus
# changes; _pane_render() draws either side from its mirror for build_screen.
# ─────────────────────────────────────────────────────────────────────────────
def _pane_snap(state: TerminalState) -> dict:
    return {f: getattr(state, f) for f in PANE_FIELDS}


def _pane_restore(state: TerminalState, snap: dict) -> None:
    for f, v in snap.items():
        setattr(state, f, v)


def activate_pane(state: TerminalState, target: int) -> None:
    """Materialize pane `target` (1|2) into the live fields, parking the
    outgoing pane in its mirror. Focus tokens: nav/content live on pane 1,
    "pane2" focus lives on pane 2."""
    if state.layout != "hsplit":
        return
    cur = 1 if state.focus in ("nav", "content") else 2
    if cur == target:
        return
    snap = _pane_snap(state)                        # park outgoing pane
    for f, v in snap.items():
        setattr(state, f"p{cur}_{f}", v)
    for f in PANE_FIELDS:                           # load incoming pane
        setattr(state, f, getattr(state, f"p{target}_{f}"))


def _pane_render(state: TerminalState, app: App, pane: int,
                 w: int, h: int) -> RenderableType:
    """Render one split pane from its mirror, leaving the live state intact.
    The focused side gets the bright-cyan border + row highlight; the other
    side renders inert (focus "inert" suppresses selection highlighting)."""
    saved_focus = state.focus
    snap = _pane_snap(state)
    for f in PANE_FIELDS:
        setattr(state, f, getattr(state, f"p{pane}_{f}"))
    focused = (pane == 1 and state.focus != "pane2") or               (pane == 2 and state.focus == "pane2")
    state.focus = "content" if focused else "inert"
    try:
        body = content_renderable(state, app, w, h)
    finally:
        state.focus = saved_focus
        _pane_restore(state, snap)
    return Panel(body, box=box.SQUARE,
                 border_style="bright_cyan" if focused else "grey30",
                 padding=(0, 0))


def heat_bg(v: Optional[float]) -> str:
    """Risk → background colour ramp: 0.0 bright green … 1.0 bright red."""
    if v is None:
        return ""
    if v < 0.15:
        return "on bright_green"
    if v < 0.40:
        return "on green"
    if v < 0.60:
        return "on yellow"
    return "on bright_red"


def render_matrix_heatmap(state: TerminalState, app: App, w: int, h: int) -> RenderableType:
    """H-view: 40 countries × 11 GFCR modules — every cell is the module risk
    (0-100%) painted on a green→red background. `<` `>` scroll the module
    window horizontally (reusing the h_hscroll machinery); edge-to-edge table,
    zero wasted padding."""
    data = app.cache("heatmap", app.heatmap_data)
    rows = sorted(data, key=lambda d: (d["name"] or "").lower())
    state.order = [d["iso"] for d in rows]          # ENTER dives the right iso
    if state.sel >= len(rows):
        state.sel = 0
    modules = GFCR_MODULES
    inner = max(2, h - 3)
    total = len(rows)
    voff = max(0, min(state.vscroll, max(0, total - inner)))
    vis = rows[voff:voff + inner]

    # column budget: ISO + COUNTRY + as many 5-char cells as fit (no padding)
    fixed = 5 + 13
    cell_w = 5
    per_page = max(1, (max(10, w) - fixed - 4) // (cell_w + 1))
    offs = min(state.hscroll, max(0, len(modules) - per_page))
    page = modules[offs:offs + per_page]

    t = Table(box=None, expand=True, pad_edge=False, show_header=True,
              header_style="bold yellow", padding=(0, 0))
    t.add_column("ISO", width=5, no_wrap=True)
    t.add_column("COUNTRY", width=13, no_wrap=True)
    for mname, col, _wgt in page:
        t.add_column(mname.split()[0][:5].upper(), width=cell_w,
                     no_wrap=True, justify="center")
    for i, d in enumerate(vis):
        abs_i = voff + i
        sel_here = abs_i == state.sel and state.focus == "content"
        cells = [Text(("▸ " if sel_here else "  ") + d["iso"],
                      style="bold black on bright_cyan" if sel_here else "bold cyan"),
                 Text((d["name"] or "")[:13], style=TXT)]
        for _mname, col, _w in page:
            v = d.get(col)
            if v is None:
                cells.append(Text("·", style="grey30"))
                continue
            style = "black on bright_cyan" if sel_here else f"black {heat_bg(v)}"
            cells.append(Text(f"{v * 100:3.0f}", style=style, justify="center"))
        t.add_row(*cells)

    sub = f"HEATMAP · {total} countries × {len(modules)} modules"
    sub += f"   rows {voff + 1}-{min(voff + inner, total)}/{total}"
    if offs + per_page < len(modules):
        sub += (f"   modules {offs + 1}-{min(offs + per_page, len(modules))}"
                f"/{len(modules)}  < >")
    leg = Text(" 0% ", style=f"black {heat_bg(0.05)}")
    leg.append(" 25% ", style=f"black {heat_bg(0.25)}")
    leg.append(" 50% ", style=f"black {heat_bg(0.5)}")
    leg.append(" 80%+ ", style=f"black {heat_bg(0.8)}")
    return Panel(Group(t, Text(sub, style=DIM), leg),
                 title="GFCR v6.0 — 11-MODULE RISK HEATMAP  (H toggles)",
                 border_style="grey30", box=box.SIMPLE, padding=(0, 0))


def content_renderable(state: TerminalState, app: App, w: int, h: int) -> RenderableType:
    app.content_w = max(20, w - 8)   # usable grid width (borders/padding)
    if state.mode == "palette":
        return render_palette(state, app, h)
    if state.mode == "search":
        return render_search(state, app, h)
    if state.mode == "watchlist":
        return render_watchlist(state, app, h)
    if state.mode == "help":
        return render_help(state, app, h)
    key = SCREENS[state.screen]["key"]
    if key == "dashboard":
        return render_dashboard(state, app, w, h)
    if key == "matrix":
        if state.matrix_heatmap:
            return render_matrix_heatmap(state, app, w, h)
        return render_matrix(state, app, w, h)
    if key == "country":
        return render_country(state, app, w, h)
    if key == "policy":
        return render_policy(state, app, w, h)
    if key == "audit":
        return render_audit(state, app, w, h)
    if key == "system":
        return render_system(state, app, w, h)
    return Text("")


def build_screen(state: TerminalState, app: App, cols: int, lines: int) -> Layout:
    """Dynamic layout, always full-size:
        line 0      live ticker tape (marquee)
        lines 1-2   header band
        body        nav rail + content  (content halves in hsplit mode)
        last 4      command line · status · hints · OMNIBAR
    """
    root = Layout()
    root.split_column(
        Layout(name="tape", size=1),
        Layout(name="header", size=2),
        Layout(name="body", ratio=1),
        Layout(name="footer", size=4),
    )
    root["tape"].update(render_ticker(state, cols))
    root["header"].update(render_header(state, app, cols))
    body_h = max(4, lines - 7)                       # 1 tape + 2 header + 4 footer

    # the nav rail shrinks slightly in split mode (Bloomberg squeezes chrome)
    nav_w = max(16, cols // 6) if state.layout == "hsplit" else max(20, cols // 5)
    body = root["body"]

    # modal overlays (palette/search/watchlist/help) draw full-width regardless
    overlay = state.mode in ("palette", "search", "watchlist", "help")
    if state.layout == "hsplit" and not overlay:
        body.split_row(
            Layout(name="nav", size=nav_w),
            Layout(name="split", ratio=1),
        )
        cw = max(30, cols - nav_w)
        split = body["split"]
        split.split_row(Layout(name="left", ratio=1), Layout(name="right", ratio=1))
        split["left"].update(_pane_render(state, app, 1, cw // 2, body_h))
        split["right"].update(_pane_render(state, app, 2, cw - cw // 2, body_h))
    else:
        body.split_row(
            Layout(name="nav", size=nav_w),
            Layout(name="content", ratio=1),
        )
        body["content"].update(content_renderable(state, app, cols - nav_w, body_h))
    body["nav"].update(render_nav(state, app, nav_w))
    root["footer"].update(render_footer(state, app, cols))
    return root


def draw_screen(console: Console, renderable: RenderableType) -> None:
    """Deterministic full-screen repaint: home cursor, redraw, clear below."""
    with console.capture() as cap:
        console.print(renderable, end="")
    text = cap.get()
    lines = text.split("\n")
    if len(lines) > console.height:                  # defensive clip
        lines = lines[:console.height]
    out = "\r\n".join(lines).rstrip("\r\n")
    sys.stdout.write("\x1b[H" + out + "\x1b[0J")
    sys.stdout.flush()

# ─────────────────────────────────────────────────────────────────────────────
# Key dispatch — a dictionary table mapping keys to handlers.
# (The old mtui's megabyte-sized if/elif chain is gone.)
# ─────────────────────────────────────────────────────────────────────────────
Handler = Callable[[TerminalState, App], None]

def sel_max(state: TerminalState, app: App) -> int:
    """Maximum selection index for the current screen (0-based, inclusive)."""
    key = SCREENS[state.screen]["key"]
    if key == "matrix":
        return max(0, len(state.order) - 1)
    if key == "policy":
        return max(0, len(app.cache("policy_events", app.policy_events)) - 1)
    if key == "audit":
        return max(0, len(app.cache(f"audit_{state.audit_imputed_only}",
                                    lambda: app.audit_rows(state.audit_imputed_only))) - 1)
    if key == "system":
        return max(0, len(SYSTEM_ACTIONS) - 1)
    return 0


def scroll_max(state: TerminalState, app: App) -> int:
    key = SCREENS[state.screen]["key"]
    inner = max(2, state._vis_h - 4) if getattr(state, "_vis_h", 0) else 10
    if key == "matrix":
        return max(0, len(state.order) - inner)
    if key == "policy":
        return max(0, len(app.cache("policy_events", app.policy_events)) - inner)
    if key == "audit":
        return max(0, len(app.cache(f"audit_{state.audit_imputed_only}",
                                    lambda: app.audit_rows(state.audit_imputed_only))) - inner)
    if key == "system":
        return max(0, len(SYSTEM_ACTIONS) - inner)
    return 0


# ── navigation ──────────────────────────────────────────────────────────────
def h_move(state: TerminalState, app: App, d: int) -> None:
    if state.focus == "nav":
        state.screen = (state.screen + d) % len(SCREENS)
        state.sel = 0
        return
    key = SCREENS[state.screen]["key"]
    inner = max(2, (getattr(state, "_vis_h", None) or 10) - 4)
    if key == "policy":                            # policy list uses policy_sel
        n = len(app.cache("policy_events", app.policy_events))
        if n:
            state.policy_sel = max(0, min(state.policy_sel + d, n - 1))
            if state.policy_sel < state.vscroll:
                state.vscroll = state.policy_sel
            if state.policy_sel >= state.vscroll + inner:
                state.vscroll = state.policy_sel - inner + 1
        return
    mx = sel_max(state, app)
    state.sel = max(0, min(state.sel + d, mx))
    if state.sel < state.vscroll:
        state.vscroll = state.sel
    if state.sel >= state.vscroll + inner:
        state.vscroll = state.sel - inner + 1


def h_scroll(state: TerminalState, app: App, d: int, page: bool = False) -> None:
    mx = scroll_max(state, app)
    step = max(3, (getattr(state, "_vis_h", 10) or 10) // 2) if page else 1
    state.vscroll = max(0, min(state.vscroll + d * step, mx))


def h_hscroll(state: TerminalState, app: App, d: int, page: bool = False) -> None:
    key = SCREENS[state.screen]["key"]
    if key != "matrix":
        return
    widths = [2 + w for w in MATRIX_COL_WIDTHS]
    k, acc = 0, 0
    while k < len(widths) and acc + widths[k] <= app.content_w:
        acc += widths[k]
        k += 1
    k = max(1, k)
    mx = max(0, len(widths) - k)
    step = k if page else 1
    state.hscroll = max(0, min(state.hscroll + d * step, mx))


def h_top(state: TerminalState, app: App) -> None:
    if state.focus == "nav":
        state.screen = 0
        state.sel = 0
    else:
        state.sel = 0
        state.vscroll = 0


def h_bottom(state: TerminalState, app: App) -> None:
    state.sel = sel_max(state, app)
    state.vscroll = max(0, state.sel - 1)


# ── mode / focus ────────────────────────────────────────────────────────────
def h_focus_content(state: TerminalState, app: App) -> None:
    if state.focus == "pane2":               # move to the left pane's content
        activate_pane(state, 1)
        state.focus = "content"
    elif state.focus != "content":
        state.focus = "content"


def h_focus_nav(state: TerminalState, app: App) -> None:
    if state.focus == "pane2":
        activate_pane(state, 1)
    state.focus = "nav"
    if state.mode in ("palette", "search", "watchlist", "help"):
        state.mode = "normal"


def h_focus_cycle(state: TerminalState, app: App) -> None:
    """Tab: nav rail → left pane → right pane → nav rail."""
    if state.focus == "nav":
        state.focus = "content"
    elif state.focus == "content":
        if state.layout == "hsplit":
            activate_pane(state, 2)           # materialize the right pane
            state.focus = "pane2"
        else:
            state.focus = "nav"
    else:                                       # "pane2" → back to nav rail
        activate_pane(state, 1)
        state.focus = "nav"


def h_enter(state: TerminalState, app: App) -> None:
    if state.focus == "nav":
        state.focus = "content"
        return
    key = SCREENS[state.screen]["key"]
    if key == "matrix" and state.order:
        iso = state.order[state.sel]
        state.sel_iso = iso
        state.screen = 2                       # Country Deep-Dive
        app.log_action(f"open {iso}")
        app.toast(f"{iso} deep-dive")
    elif key == "audit":
        # rows present: dive into the selected audit row's country
        # table empty:   run the selected ETL quick action instead
        rows = app.cache(f"audit_{state.audit_imputed_only}",
                         lambda: app.audit_rows(state.audit_imputed_only))
        if rows and 0 <= state.sel < len(rows):
            state.sel_iso = rows[state.sel]["iso"]
            state.screen = 2
            app.toast(rows[state.sel]["iso"] + " deep-dive")
        elif not rows and 0 <= state.sel < len(AUDIT_QUICK):
            title, argv, _d = AUDIT_QUICK[state.sel]
            app.run_job(title, argv)
    elif key == "system":
        if 0 <= state.sel < len(SYSTEM_ACTIONS):
            title, argv, _d = SYSTEM_ACTIONS[state.sel]
            app.run_job(title, argv)
    elif key == "policy":
        pass                                      # selection IS the detail pane


def h_screen(state: TerminalState, app: App, idx: int) -> None:
    state.screen = idx % len(SCREENS)
    state.sel = 0
    state.vscroll = 0
    state.hscroll = 0


def h_sort(state: TerminalState, app: App) -> None:
    state.sort_key = SORT_KEYS[(SORT_KEYS.index(state.sort_key) + 1) % len(SORT_KEYS)]
    state.sort_asc = False
    app.log_action(f"sort {state.sort_key}")


def h_sort_flip(state: TerminalState, app: App) -> None:
    state.sort_asc = not state.sort_asc
    app.log_action(f"sort {state.sort_key} {'asc' if state.sort_asc else 'desc'}")


def h_toggle_watch(state: TerminalState, app: App) -> None:
    key = SCREENS[state.screen]["key"]
    iso = None
    if key == "matrix" and state.order:
        iso = state.order[state.sel]
    elif key == "country":
        iso = state.sel_iso
    elif state.mode == "watchlist" and state.res_idx < len(sorted(state.watch)):
        iso = sorted(state.watch)[state.res_idx]
    if iso:
        if iso in state.watch:
            state.watch.discard(iso)
            app.toast(f"★ unpinned {iso}")
        else:
            state.watch.add(iso)
            app.toast(f"★ pinned {iso}")
        app.save_watchlist()


def h_audit_filter(state: TerminalState, app: App) -> None:
    state.audit_imputed_only = not state.audit_imputed_only
    app.bump()
    app.toast("audit filter: " + ("ESTIMATED/missing ONLY" if state.audit_imputed_only else "ALL"))


def h_export(state: TerminalState, app: App) -> None:
    key = SCREENS[state.screen]["key"]
    ts = time.strftime("%Y%m%d-%H%M%S")
    rows = []
    if key == "matrix":
        data = app.cache("matrix", app.matrix_data)
        rows = [("iso3", "country", "score", "tier", "s_eff", "fiscal", "ext", "dyn"),
                *[(d["iso"], d["name"], d["gfcr_score"], d["gfcr_tier"], d["s_eff"],
                   d["fiscal_stress"], d["external_vulnerability"], d["dynamical_stress"])
                  for d in data]]
    elif key == "audit":
        rows = [("iso3", "year", "indicator", "source", "flag", "raw", "final"),
                *[(d["iso"], d["year"], d["indicator"], d["source"],
                   d["imputation_flag"], d["raw_value"], d["final_value"])
                  for d in app.cache(f"audit_{state.audit_imputed_only}",
                                     lambda: app.audit_rows(state.audit_imputed_only))]]
    elif key == "policy":
        events = app.cache("policy_events", app.policy_events)
        rows = [("iso3", "event_date", "type", "description"),
                *[(e["iso3"], e["event_date"], e["event_type"], e["description"])
                  for e in events]]
    elif key == "dashboard":
        data = app.cache("matrix", app.matrix_data)
        rows = [("iso3", "gfcr_score", "tier"), *[(d["iso"], d["gfcr_score"],
                                                   d["gfcr_tier"]) for d in data]]
    if not rows:
        app.toast("nothing to export here")
        return
    path = EXPORT_DIR / f"{key}_{ts}.csv"
    try:
        with open(path, "w", newline="", encoding="utf-8") as fh:
            csv.writer(fh).writerows(rows)
    except OSError as exc:
        log_error(f"export: {exc}")
        app.toast("export failed — see error.log")
        return
    copy_clipboard(open(path).read())
    msg = f"exported {len(rows) - 1} rows → {path.name}"
    if copy_clipboard(""):
        msg += " · clipboard"
    app.toast(msg)
    app.log_action(f"export {key}")


def copy_clipboard(text: str) -> bool:
    for tool in (["xclip", "-selection", "clipboard"], ["wl-copy"],
                 ["xsel", "--clipboard", "--input"], ["pbcopy"]):
        if not shutil.which(tool[0]):
            continue
        try:
            p = subprocess.Popen(tool, stdin=subprocess.PIPE,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            p.communicate(text.encode("utf-8"), timeout=8)
            return p.returncode == 0     # 0 = the tool really accepted the text
        except Exception:
            continue
    return False


def _copy_code() -> int:
    """`mtui --code`: copy mtui's own full source to the clipboard.

    Reads the script itself (including any new code), pushes it through the
    first working clipboard tool, then — when a matching read-back tool is
    installed — pastes it back and compares byte-for-byte so a truncated or
    mangled copy is reported as an error instead of silently succeeding.
    """
    src = Path(__file__).resolve()
    if not src.exists():
        print(f"mtui --code: cannot find source at {src}", file=sys.stderr)
        return 1
    code = src.read_text(encoding="utf-8")
    payload = code.encode("utf-8")
    sha = hashlib.sha256(payload).hexdigest()
    n_lines = code.count("\n") + 1

    if not copy_clipboard(code):
        print("mtui --code: no clipboard tool found (need xclip/wl-copy/xsel/pbcopy)",
              file=sys.stderr)
        return 1

    print(f"mtui --code: copied {src} to clipboard")
    print(f"  {n_lines} lines · {len(payload):,} bytes · sha256 {sha[:16]}…")

    # ── round-trip verification: paste back with the same clipboard family ──
    readback: list[str] | None = None
    for tool in ([["wl-paste", "--no-newline"], ["wl-copy"]],
                 [["xclip", "-selection", "clipboard", "-o"], ["xclip"]],
                 [["xsel", "--clipboard", "--output"], ["xsel"]],
                 [["pbpaste"], ["pbcopy"]]):
        if shutil.which(tool[1][0]):          # we copied with this family
            if shutil.which(tool[0][0]):      # its read-back tool exists
                readback = tool[0]
            break
    if readback is None:
        print("  ✓ copied (no read-back tool installed — paste to verify safely)")
        return 0
    try:
        p = subprocess.Popen(readback, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        got = p.communicate(timeout=8)[0].replace(b"\r\n", b"\n").replace(b"\r", b"\n")
    except Exception as exc:
        print(f"  ? read-back unavailable ({exc}) — paste to verify", file=sys.stderr)
        return 0
    # a trailing newline is often added/kept by clipboard tools — normalize it
    got_n = got.rstrip(b"\n")
    want_n = payload.rstrip(b"\n")
    if got_n == want_n:
        print(f"  ✓ verified: read back {len(got):,} bytes — ALL {n_lines} lines intact")
        return 0
    if not got:
        print("  ✗ copy FAILED: nothing landed in the clipboard"
              " (tool exited 0 but no data available).", file=sys.stderr)
    else:
        print("  ✗ MISMATCH: copied text differs from the source!"
              f" (sent {len(payload):,} b, got {len(got):,} b)", file=sys.stderr)
    return 1


