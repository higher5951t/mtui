def render_ticker(state: TerminalState, cols: int) -> RenderableType:
    """Line 0 — the live market marquee.

    Quotes are pulled from state.market_data (written by the MarketDaemon).
    The window slides TAPE_SPEED chars/second using the wall clock, so the
    dirty-check sig tuple picks the movement up at the normal repaint cadence
    (no extra timer, no busy redraw). Green = up, red = down, trading-floor
    style. OFFLINE is shown when --offline / no yfinance / no internet.
    """
    if state.offline:
        return Text("  TAPE OFFLINE — live market disabled (--offline)"
                    + "─" * max(0, cols - 45), style="grey30")
    if not state.market_live:
        msg = f"  TAPE — connecting to yahoo finance…  {state.market_err}"
        return Text(msg[:cols].ljust(cols), style="bold yellow")
    quotes: list[Text] = []
    for tag, _sym, label in TICKERS:
        if tag not in state.market_data:
            continue
        px, chg, pct = state.market_data[tag]
        up = pct >= 0
        q = Text(f"  {label:<11}", style="bold cyan")
        q.append(f"{px:>9.1f}", style="bold white")
        q.append(f" {chg:>+7.1f} {pct:>+5.1f}%",
                 style="bold bright_green" if up else "bold bright_red")
        quotes.append(q)
    if not quotes:
        return Text("  TAPE — awaiting market data…".ljust(cols), style=DIM)
    tape = Text("▐", style="grey30")
    for q in quotes:
        tape.append_text(q)
    tape.append("▌", style="grey30")
    total = len(tape)
    big = tape + tape + tape                        # triple copy: seamless wrap
    off = int(time.time() * TAPE_SPEED) % total     # char-exact marquee slide
    line = big[off:off + cols]                      # Text slicing keeps styles
    if len(line) < cols:
        line.append_text(Text(" " * (cols - len(line)), style=DIM))
    return line


def render_header(state: TerminalState, app: App, cols: int) -> RenderableType:
    """Top band: system id · module · round · clock · DB status · alerts."""
    module = f"{SCREENS[state.screen]['icon']} {SCREENS[state.screen]['name'].upper()}"
    left = Text()
    left.append(" MTUI ", style="bold black on bright_blue")
    left.append("  PAPERFLOW ", style="bold yellow")
    left.append("GFCR v6.0", style="yellow")
    left.append(f" │ {module}", style="bold grey93")

    db = app.pool.status()
    right = Text()
    right.append(" │ ", style=DIM)
    right.append(f"ROUND {app.rating_year or '—'}", style=YELLOW)
    right.append(" │ ", style=DIM)
    right.append(f"DB:{db['label']}", style=f"bold {db['color']}")
    right.append(" │ ", style=DIM)
    n_al = app.alert_count()
    right.append(f"ALRT {n_al}", style=CRIT if n_al else "white")
    right.append(" │ ", style=DIM)
    right.append(time.strftime("%H:%M:%S"), style="bold cyan")

    return Group(pad_pair(left, right, cols), Rule(style="grey30"))


def render_nav(state: TerminalState, app: App, width: int) -> RenderableType:
    """Left rail (≈15%): the six functional screens + mini status footer."""
    grid = Table.grid(padding=(0, 1), expand=True)
    grid.add_column(ratio=1)
    for i, s in enumerate(SCREENS):
        active, focused = (i == state.screen), (i == state.screen and state.focus == "nav")
        label = s.get("short", s["name"]).upper()
        row = Text()
        if focused:                                   # reverse-video selector
            row.append(f" {s['icon']} {label} ", style=SEL)
        elif active:
            row.append(f" {s['icon']} ", style=AMBER)
            row.append(label, style=f"bold {AMBER}")
            row.append(" ◀", style=CYAN)
        else:
            row.append(f" {s['icon']} ", style=DIM)
            row.append(label, style=TXT)
        grid.add_row(row)

    grid.add_row(Text("", style=DIM))
    watch_n = len(state.watch)
    grid.add_row(Text(f"{len(app.countries())} countries · {app.alert_count()} alerts",
                      style=DIM))
    grid.add_row(Text(f"watch {watch_n} · round {app.rating_year or '—'}", style=DIM))
    return Panel(grid, box=box.SQUARE, border_style="grey23", padding=(0, 0))


def render_footer(state: TerminalState, app: App, cols: int) -> RenderableType:
    """Bottom band: command line · status line · keybinding hint."""
    c = state
    # line 1 — command buffer / running job ticker
    if c.mode in ("palette", "search"):
        kind = "SEARCH" if c.mode == "search" else "CMD"
        line1 = Text(f" {kind} ", style=SEL)
        line1.append(f" » {c.query}▌ ", style="bold white")
        line1.append(f"({len(c.results)} hits)", style=DIM)
    else:
        line1 = Text()
        line1.append(" » ", style=CYAN)
        if c.job and c.job.running:
            line1.append(f"⏳ {c.job.title}", style="bold yellow")
            tail = c.job.lines[-1] if c.job.lines else ""
            line1.append("  " + tail[:cols - 44], style="grey70")
        elif c.job and c.job.done:
            ok = c.job.rc in (0, None)
            line1.append(f"{'✔' if ok else '✘'} {c.job.title} "
                         f"(exit {c.job.rc})", style="green" if ok else "red")
        else:
            line1.append(": commands · Ctrl+F global search · F2 watchlist",
                         style=DIM)

    # line 2 — toast + last two actions
    line2 = Text()
    if c.toast and time.monotonic() - c.toast_t < 4.0:
        line2.append("▌ " + c.toast + " ", style="bold magenta")
    for a in app.action_log:
        line2.append(" · " + a, style="grey60")
    line2 = pad_pair(line2, Text(time.strftime("%H:%M:%S"), style="bold cyan"), cols)

    # line 3 — contextual keybinding hint
    hints = {
        "normal": "↑↓ nav · Enter act · Tab focus · 1-6 · s sort · H heatmap · "
                  "< > h-scroll · W pin · E export · / palette · SPACE omni · "
                  "F9 split · F3/F4 ws",
        "palette": "type to filter · ↑↓ pick · Enter run · Esc cancel",
        "search": "type to search DB · ↑↓ pick · Enter open · Esc cancel",
        "watchlist": "↑↓ pick · Enter deep-dive · W unpin · Esc close",
        "omni": "ISO→dive · MAT/DIV/AUD/SYS→screen · GGXWDG→macro · AAPL→quote · Esc",
        "help": "any key or Esc to close",
    }[c.mode]
    hint_line = pad_pair(Text(hints, style=DIM), Text("q quit", style=DIM), cols)

    # line 4 — OMNIBAR (very bottom line, Line L-1): Bloomberg-style jump bar
    omni = Text()
    if c.mode == "omni":
        omni.append(" OMNIBAR ", style=SEL)
        omni.append(f" {c.omni_query}▌ ", style="bold white")
        omni.append("ISO→deep-dive · MAT/DIV/AUD/SYS→screen · GGXWDG→global search · "
                    "AAPL→live quote · Esc close", style=DIM)
    else:
        omni.append(" OMNIBAR ", style="grey30")
        omni.append("SPACE ", style=CYAN)
        omni.append("jump — ISO · function code · macro code · ticker quote   "
                    "F3 cycle ws · F4 save ws · F9 split · H heatmap", style=DIM)
    return Group(line1, line2, hint_line, omni)


# ─────────────────────────────────────────────────────────────────────────────
# Generic dense data grid (used by matrix / audit / policy / system)
# ─────────────────────────────────────────────────────────────────────────────
def render_grid(state: TerminalState, app: App, title: str, cols: list,
                rows: list, height: int, sel: int | None = None,
                subtitle: str = "") -> RenderableType:
    """Vertical + horizontal scrolling grid, Bloomberg density, box.NONE."""
    inner = max(2, height - 4)                       # title + header + borders
    total = len(rows)
    voff = max(0, min(state.vscroll, max(0, total - inner)))
    vis = rows[voff:voff + inner]

    # horizontal column window (the <> keys shift it)
    start_c, end_c = col_window(cols, state.hscroll, app.content_w)
    win = cols[start_c:end_c]

    t = Table(box=box.SIMPLE, expand=False, pad_edge=False, show_header=True,
              header_style="bold yellow", padding=(0, 1))
    for hd, wdt, _fn in win:
        t.add_column(hd, width=wdt, no_wrap=True)
    for i, row in enumerate(vis):
        abs_i = voff + i
        if sel is not None and abs_i == sel and state.focus == "content":
            # selected row: reverse-video (cells keep their plain text)
            cells = [Text(fn(row).plain, style="bold black on bright_cyan")
                     for _hd, _wdt, fn in win]
        else:
            cells = [fn(row) for _hd, _wdt, fn in win]
        t.add_row(*cells)

    sub = f"{voff + 1}-{min(voff + inner, total)} / {total}" if total else "empty"
    if end_c < len(cols):
        sub += f"   cols {start_c + 1}-{end_c}/{len(cols)}  < >"
    if subtitle:
        sub = subtitle + "   " + sub
    return Panel(t, title=title, title_align="left", subtitle=sub,
                 subtitle_align="right", border_style=CYAN if state.focus == "content" else "grey30",
                 box=box.SIMPLE, padding=(0, 0))


