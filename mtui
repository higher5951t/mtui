def term_size() -> tuple[int, int]:
    """Current terminal size. A 0x0 pty (script/CI) falls back to a sane
    canvas instead of rendering an empty frame."""
    try:
        sz = os.get_terminal_size(sys.stdout.fileno())
        if sz.columns < 10 or sz.lines < 5:
            return 100, 32
        return sz.columns, sz.lines
    except OSError:
        return 100, 32


def make_sig(state: TerminalState, app: App, cols: int, lines: int) -> tuple:
    if state.toast and time.monotonic() - state.toast_t > 4.0:
        state.toast = ""
    j = state.job
    job_sig = (j.title, j.rc, len(j.lines), bool(j.running)) if j else (None, None, 0, False)
    mkt = (state.market_live,
           tuple(sorted((k, v[0], v[1], v[2]) for k, v in state.market_data.items())))
    p2 = (state.p2_screen, state.p2_sel, state.p2_sel_iso, state.p2_policy_sel,
          state.p2_sort_key, state.p2_sort_asc, state.p2_hscroll, state.p2_vscroll,
          state.p2_audit_imputed_only)
    p1 = (state.p1_screen, state.p1_sel, state.p1_sel_iso, state.p1_policy_sel,
          state.p1_sort_key, state.p1_sort_asc, state.p1_hscroll, state.p1_vscroll,
          state.p1_audit_imputed_only)
    return (cols, lines, state.screen, state.focus, state.sel, state.vscroll,
            state.hscroll, state.sort_key, state.sort_asc, state.mode,
            state.query, state.res_idx, len(state.results), state.audit_imputed_only,
            state.sel_iso, state.policy_sel, tuple(sorted(state.watch)),
            state.toast, int(time.time()), state.refresh, job_sig,
            state.layout, state.matrix_heatmap, state.omni_query,
            state.workspace_idx, p1, p2, mkt,
            int(time.time() * TAPE_SPEED))


def main() -> None:
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print("mtui — Bloomberg-style sovereign rating terminal (paperflow GFCR v6.0)")
        print(f"usage: mtui             launch the terminal (v{VERSION})")
        print("       mtui --version    show version")
        print("       mtui --code       copy mtui's full source code to the clipboard")
        print("       mtui --offline    launch without the live market tape")
        return
    if "--version" in args:
        print(f"mtui {VERSION}")
        return
    if "--code" in args:
        sys.exit(_copy_code())
    offline = "--offline" in args

    if not (sys.stdin.isatty() and sys.stdout.isatty()) and not os.environ.get("MTUI_SMOKE"):
        print("mtui needs an interactive terminal. Run it directly in your shell.",
              file=sys.stderr)
        sys.exit(2)
    try:
        import rich  # noqa: F401
    except ImportError:
        print("mtui requires the 'rich' library:  pip install rich", file=sys.stderr)
        sys.exit(2)

    app = App()
    app.market_start(offline=offline)            # boot the ticker tape thread
    if os.environ.get("MTUI_SMOKE"):
        _smoke(app)
        return

    term = Terminal()
    try:
        term.enter()
    except (RuntimeError, OSError) as exc:
        print(f"mtui: {exc}", file=sys.stderr)
        sys.exit(2)

    state = app.s
    last_sig = None
    console = app.console
    try:
        while not state.quit:
            cols, lines = term_size()
            if app._last_size != (cols, lines):       # dynamic resize support
                app._last_size = (cols, lines)
                app.console = Console(force_terminal=True, highlight=False,
                                      width=cols, height=lines, legacy_windows=False)
                console = app.console
            state._vis_h = max(10, lines - 7)      # tape+header+footer budget
            sig = make_sig(state, app, cols, lines)
            if sig != last_sig:
                try:
                    draw_screen(console, build_screen(state, app, cols, lines))
                except Exception as exc:
                    log_error(f"render: {exc}")
                    state.toast = "render error — see ~/.mtui/error.log"
                    state.toast_t = time.monotonic()
                    try:
                        draw_screen(console, Text("render error see log", style="red"))
                    except OSError:
                        pass
                last_sig = sig
            try:
                key = read_key(timeout=1.0)
            except Exception as exc:
                # a key-decoder bug must never kill the terminal
                log_error(f"read_key: {exc}")
                state.toast = "key decode error — see ~/.mtui/error.log"
                state.toast_t = time.monotonic()
                key = None
            if key is not None:
                try:
                    handle_key(state, app, key)
                except Exception as exc:
                    log_error(f"key {key!r}: {exc}")
                    state.toast = "key error — see ~/.mtui/error.log"
                    state.toast_t = time.monotonic()
    except KeyboardInterrupt:
        pass
    finally:
        term.restore()
        app.market_stop()                      # stop the tape thread
        app.pool.close()
        print("mtui — bye. (Paperflow GFCR v6.0 Bloomberg terminal)")


def _smoke(app: App) -> None:
    """Headless render test: draw every screen/overlay to a fixed-size console."""
    out = io.StringIO()
    console = Console(width=120, height=40, force_terminal=True, file=out)
    state = app.s
    print("MTUI smoke test — rendering all screens at 120x40\n")
    state.offline = True                       # deterministic: no network
    for i, s in enumerate(SCREENS):
        state.screen = i
        state.mode = "normal"
        try:
            r = build_screen(state, app, 120, 40)
            console.print(r)
            lines = out.getvalue().count("\n") + 1
            print(f"  screen {i} {s['key']:<12} rendered  ({lines} lines)")
        except Exception as exc:
            log_error(f"smoke {s['key']}: {exc}")
            print(f"  screen {i} {s['key']:<12} FAILED: {exc}")
        out.seek(0)
        out.truncate()
    # overlays
    for mode, q in (("palette", "usa"), ("search", "debt"), ("watchlist", ""), ("help", "")):
        state.mode = mode
        state.query = q
        try:
            console.print(build_screen(state, app, 120, 40))
            print(f"  overlay {mode:<12} rendered")
        except Exception as e:
            print(f"  overlay {mode} FAILED: {e}")
        out.seek(0)
        out.truncate()

    # new features: heatmap, split panes, live tape (fake snapshot)
    checks = [
        ("heatmap",      lambda: setattr(state, "matrix_heatmap", True), "summary"),
        ("split-panes",  lambda: setattr(state, "layout", "hsplit"), "single"),
        ("split/pane2",  lambda: setattr(state, "focus", "pane2"), None),
    ]
    state.screen, state.mode = 1, "normal"
    for label, mutate, back in checks:
        mutate()
        try:
            console.print(build_screen(state, app, 120, 40))
            print(f"  feature {label:<12} rendered")
        except Exception as exc:
            log_error(f"smoke {label}: {exc}")
            print(f"  feature {label:<12} FAILED: {exc}")
        if back:
            setattr(state, "matrix_heatmap", False if back == "summary" else True)
        if back == "split":
            state.layout = "single"
            state.focus = "nav"
        out.seek(0)
        out.truncate()
    # tape with a fake snapshot (colours + marquee)
    state.market_data = {"SPX": (5300.1, +12.3, 0.24), "VIX": (13.4, -0.8, -5.6),
                         "US10Y": (4.22, 0.01, 0.2), "GOLD": (2550.0, 8.0, 0.3),
                         "WTI": (82.1, -1.1, -1.3), "BTC": (97000, 1500, 1.6)}
    state.market_live = True
    state.offline = False
    state.layout = "single"
    state.focus = "nav"
    try:
        console.print(build_screen(state, app, 120, 40))
        print("  feature tape          rendered (live snapshot)")
    except Exception as e:
        print(f"  feature tape FAILED: {e}")
    print("\nsmoke complete.")


