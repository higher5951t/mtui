def render_ticker(state: TerminalState, cols: int) -> RenderableType:
    """Line 0 — compact market status pip (full data on Live Markets screen).

    Replaces the old scrolling marquee. Shows up to 6 ticker chips with
    price + %chg in 1 line, plus a LIVE/OFFLINE/CONNECTING badge. Click into
    the Live Markets screen (7 / MKT) for OHLC, history charts, and detail.
    """
    line = Text()
    if state.offline:
        line.append(" ◉ MKT ", style="bold grey30")
        line.append("OFFLINE ", style="bold red")
        line.append("— press 7 for Live Markets screen", style="grey30")
        line.append(" " * max(0, cols - len(line.plain)), style="grey30")
        return line
    if not state.market_live:
        line.append(" ◉ MKT ", style="bold yellow")
        line.append("CONNECTING ", style="bold yellow")
        err = state.market_err or state.market_last_err
        if err:
            line.append(f"({err[:60]})", style="grey50")
        line.append(" " * max(0, cols - len(line.plain)), style="grey30")
        return line
    # live: show compact chips for first 6 tickers
    line.append(" ◉ MKT ", style="bold green")
    line.append("LIVE ", style="bold bright_green")
    shown = 0
    for tag, _sym, _label, _cat in TICKERS:
        if shown >= 6:
            break
        d = state.market_data.get(tag)
        if not d:
            continue
        up = d["pct"] >= 0
        line.append(f" {tag} ", style="bold cyan")
        line.append(f"{d['px']:>9.2f}", style="bold white")
        line.append(f" {d['pct']:>+5.2f}%",
                    style="bright_green" if up else "bright_red")
        shown += 1
    n_extra = max(0, len([t for t in TICKERS if t[0] in state.market_data]) - 6)
    if n_extra:
        line.append(f"  +{n_extra} more (7→screen)", style="grey50")
    # pad / clip
    if len(line.plain) < cols:
        line.append(" " * (cols - len(line.plain)), style="grey30")
    elif len(line.plain) > cols:
        line = line[:cols]
    return line


def render_header(state: TerminalState, app: App, cols: int) -> RenderableType:
    """Top band: system id · module · round · clock · DB status · alerts."""
    module = f"{SCREENS[state.screen]['icon']} {SCREENS[state.screen]['name'].upper()}"
    left = Text()
    left.append(" MTUI ", style="bold black on bright_blue")
    left.append("  PAPERFLOW ", style="bold yellow")
    left.append("GFCR v6.0", style="yellow")
    left.append(f" │ {module}", style="bold grey93")

    db = app.pool.status()
    right = Text()
    right.append(" │ ", style=DIM)
    right.append(f"ROUND {app.rating_year or '—'}", style=YELLOW)
    right.append(" │ ", style=DIM)
    right.append(f"DB:{db['label']}", style=f"bold {db['color']}")
    right.append(" │ ", style=DIM)
    n_al = app.alert_count()
    right.append(f"ALRT {n_al}", style=CRIT if n_al else "white")
    right.append(" │ ", style=DIM)
    right.append(time.strftime("%H:%M:%S"), style="bold cyan")

    return Group(pad_pair(left, right, cols), Rule(style="grey30"))


def render_nav(state: TerminalState, app: App, width: int) -> RenderableType:
    """Left rail: functional screens + mini status footer. Expands on focus."""
    grid = Table.grid(padding=(0, 1), expand=True)
    grid.add_column(ratio=1)
    expanded = width > 20

    for i, s in enumerate(SCREENS):
        active, focused = (i == state.screen), (i == state.screen and state.focus == "nav")
        label = s.get("short", s["name"]).upper()
        if expanded:
            row = Text()
            if focused:
                row.append(f" {s['icon']} {label} ", style=SEL)
            elif active:
                row.append(f" {s['icon']} ", style=AMBER)
                row.append(label, style=f"bold {AMBER}")
                row.append(" ◀", style=CYAN)
            else:
                row.append(f" {s['icon']} ", style=DIM)
                row.append(label, style=TXT)
        else:
            # Collapsed mode: icon only
            if focused:
                row = Text(f" {s['icon']} ", style=SEL)
            elif active:
                row = Text(f" {s['icon']} ", style=f"bold {AMBER}")
            else:
                row = Text(f" {s['icon']} ", style=DIM)
        grid.add_row(row)

    if expanded:
        grid.add_row(Text("", style=DIM))
        watch_n = len(state.watch)
        grid.add_row(Text(f"{len(app.countries())} countries · {app.alert_count()} alerts",
                          style=DIM))
        grid.add_row(Text(f"watch {watch_n} · round {app.rating_year or '—'}", style=DIM))
