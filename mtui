# ─────────────────────────────────────────────────────────────────────────────
# Read-only SQLite connection pool.
# Persistent mode=ro connections (no open/close per render), thread-safe,
# self-healing: a stale connection is dropped and reopened exactly once.
# ─────────────────────────────────────────────────────────────────────────────
class DBPool:
    def __init__(self, paths: list[Path]) -> None:
        self._paths = list(paths)
        self._conns: dict[Path, sqlite3.Connection] = {}
        self._lock = threading.RLock()

    @staticmethod
    def _open(path: Path) -> sqlite3.Connection:
        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True,
                              check_same_thread=False, timeout=10.0)
        con.row_factory = sqlite3.Row
        con.execute("PRAGMA query_only=ON")     # belt & braces: read-only
        return con

    def query(self, db: Path, sql: str, params: tuple = ()) -> Optional[list]:
        """Read-only SELECT. Returns a list of sqlite3.Row, or None on failure."""
        if not db.exists():
            return None
        with self._lock:
            for attempt in (1, 2):
                con = self._conns.get(db)
                if con is None:
                    try:
                        con = self._open(db)
                        self._conns[db] = con
                    except sqlite3.Error as exc:
                        log_error(f"DB open failed {db}: {exc}")
                        return None
                try:
                    return con.execute(sql, params).fetchall()
                except sqlite3.Error as exc:
                    # schema changed / WAL checkpoint collision -> purge & retry
                    try:
                        con.close()
                    except sqlite3.Error:
                        pass
                    self._conns.pop(db, None)
                    if attempt == 2:
                        log_error(f"DB query failed {db}: {exc}")
                        return None

    def scalar(self, db: Path, sql: str, default=0, params: tuple = ()):
        rows = self.query(db, sql, params)
        if rows and rows[0][0] is not None:
            return rows[0][0]
        return default

    def close(self) -> None:
        with self._lock:
            for con in self._conns.values():
                try:
                    con.close()
                except sqlite3.Error:
                    pass
            self._conns.clear()

    def status(self) -> dict:
        main_ok = MAIN_DB.exists() and self.query(MAIN_DB, "SELECT 1") is not None
        gf_ok = GFCR_DB.exists() and self.query(GFCR_DB, "SELECT 1") is not None
        if main_ok and gf_ok:
            label, color = "LIVE", GREEN
        elif main_ok or gf_ok:
            label, color = "PARTIAL", YELLOW
        else:
            label, color = "MISSING", RED
        return {"label": label, "color": color, "main": main_ok, "gf": gf_ok}


# ─────────────────────────────────────────────────────────────────────────────
# MarketDaemon — live Yahoo Finance tape.
# A daemon thread polls yfinance every MARKET_POLL seconds and writes the
# snapshot into state.market_data (GIL makes the small dict write atomic).
# yfinance is imported lazily: no package / no internet / --offline simply
# leaves the tape in OFFLINE mode — the terminal never crashes without it.
# ─────────────────────────────────────────────────────────────────────────────
class MarketDaemon(threading.Thread):
    def __init__(self, state: TerminalState) -> None:
        super().__init__(daemon=True, name="MarketDaemon")
        self.state = state
        self._stop = threading.Event()

    def stop(self) -> None:
        self._stop.set()

    def run(self) -> None:
        try:
            import yfinance as yf
            import pandas as pd
        except ImportError:
            self.state.offline = True
            self.state.market_err = "yfinance not installed"
            return
        symbols = [t[1] for t in TICKERS] + [t[1] for t in self.state.market_custom]
        while not self._stop.is_set():
            try:
                df = yf.download(tickers=symbols, period="6mo", interval="1d",
                                 progress=False, group_by="ticker", threads=4)
                if df is None or df.empty or df.shape[0] < 1:
                    raise RuntimeError("empty download")
                all_tickers = list(TICKERS) + list(self.state.market_custom)
                for tag, sym, label, category in all_tickers:
                    try:
                        sub = df[sym] if isinstance(df.columns, pd.MultiIndex) else df
                        if sub.empty: continue
                        # NaN-safe: the multi-symbol frame contains rows for
                        # sessions with no trade (NaN). Drop them everywhere.
                        closes = sub["Close"].dropna()
                        if closes.empty:
                            continue
                        px = float(closes.iloc[-1])          # latest session
                        prev = float(closes.iloc[-2]) if closes.size > 1 else px
                        chg = px - prev
                        pct = chg / prev * 100.0 if prev else 0.0

                        history = [float(x) for x in closes.tolist()]
                        ohlc = []
                        for i in range(len(sub)):
                            o = float(sub["Open"].iloc[i]); hh = float(sub["High"].iloc[i])
                            ll = float(sub["Low"].iloc[i]); cc = float(sub["Close"].iloc[i])
                            if not (o == o and hh == hh and ll == ll and cc == cc):
                                continue          # skip NaN/zero-volume sessions
                            vv = float(sub["Volume"].iloc[i]) if "Volume" in sub else 0.0
                            ohlc.append({"o": o, "h": hh, "l": ll, "c": cc,
                                         "v": vv if vv == vv else 0.0})

                        hi_col = sub["High"].dropna()
                        lo_col = sub["Low"].dropna()
                        op_col = sub["Open"].dropna()
                        vo_col = sub["Volume"].dropna() if "Volume" in sub else pd.Series(dtype=float)
                        day_high = float(hi_col.iloc[-1]) if len(hi_col) else px
                        day_low  = float(lo_col.iloc[-1]) if len(lo_col) else px
                        open_px  = float(op_col.iloc[-1]) if len(op_col) else px
                        vol      = float(vo_col.iloc[-1]) if len(vo_col) else 0.0

                        fetch_info = tag not in self.state.market_data or not self.state.market_data[tag].get("market_cap")
                        mkt_cap, ma50, ma200 = 0.0, 0.0, 0.0
                        if fetch_info:
                            try:
                                fi = yf.Ticker(sym).fast_info
                                mkt_cap = float(fi.get("market_cap", 0) or 0)
                                ma50 = float(fi.get("fifty_day_average", 0) or 0)
                                ma200 = float(fi.get("two_hundred_day_average", 0) or 0)
                            except Exception:
                                pass
                        else:
                            d = self.state.market_data.get(tag, {})
                            mkt_cap = d.get("market_cap", 0.0)
                            ma50 = d.get("ma50", 0.0)
                            ma200 = d.get("ma200", 0.0)

                        self.state.market_data[tag] = {
                            "px": px, "chg": chg, "pct": pct,
                            "prev_close": prev, "open": open_px,
                            "day_high": day_high, "day_low": day_low,
                            "volume": vol, "history": history, "ohlc": ohlc,
                            "label": label, "symbol": sym, "category": category,
                            "market_cap": mkt_cap, "ma50": ma50, "ma200": ma200,
                            "high_6m": max(history) if history else px,
                            "low_6m": min(history) if history else px,
                        }
                        self.state.market_live = True
                        self.state.market_last_err = ""
                    except (KeyError, TypeError, ValueError, IndexError) as exc:
                        self.state.market_last_err = f"{tag}: {exc}"[:80]
                        continue
            except Exception as exc:
                self.state.market_err = str(exc)[:90]
                self.state.market_last_err = self.state.market_err
            if not self._stop.is_set():
                self._stop.wait(MARKET_POLL)


# ─────────────────────────────────────────────────────────────────────────────
# Background ETL job: pipes stdout/stderr into a ring buffer the UI renders
# live; killed via its own process group.
# ─────────────────────────────────────────────────────────────────────────────
class Job:
    def __init__(self, title: str, argv: list[str]) -> None:
        self.title = title
        self.argv = argv
        self.cmd = [PAPERFLOW_CMD, *argv]
        self.proc: Optional[subprocess.Popen] = None
        self.lines: deque[str] = deque(maxlen=400)
        self.rc: Optional[int] = None
        self.started = time.time()

    def start(self) -> None:
        self.proc = subprocess.Popen(
            self.cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1, cwd=PAPERFLOW_DIR, preexec_fn=os.setsid)
        threading.Thread(target=self._pump, daemon=True).start()

    def _pump(self) -> None:
        assert self.proc is not None and self.proc.stdout is not None
        for line in self.proc.stdout:
            self.lines.append(line.rstrip("\r\n"))
        self.rc = self.proc.wait()

    def kill(self) -> None:
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(os.getpgid(self.proc.pid), signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
            try:
                self.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(os.getpgid(self.proc.pid), signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    pass
        if self.rc is None:
            self.rc = -9

    @property
    def done(self) -> bool:
        return self.rc is not None

    @property
    def running(self) -> bool:
        return self.proc is not None and self.proc.poll() is None


