        rows = self.pool.query(PAPERTRADE_DB,
            "SELECT date, nav, benchmark FROM paper_nav WHERE backtest_id=? "
            "ORDER BY date", (bt_id,))
        return [dict(r) for r in (rows or [])]

    def papertrade_positions(self, bt_id: int) -> list[dict]:
        if not PAPERTRADE_DB.exists():
