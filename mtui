# ─────────────────────────────────────────────────────────────────────────────
# Read-only SQLite connection pool.
# Persistent mode=ro connections (no open/close per render), thread-safe,
# self-healing: a stale connection is dropped and reopened exactly once.
# ─────────────────────────────────────────────────────────────────────────────
class DBPool:
    def __init__(self, paths: list[Path]) -> None:
        self._paths = list(paths)
        self._conns: dict[Path, sqlite3.Connection] = {}
        self._lock = threading.RLock()

    @staticmethod
    def _open(path: Path) -> sqlite3.Connection:
        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True,
                              check_same_thread=False, timeout=10.0)
        con.row_factory = sqlite3.Row
        con.execute("PRAGMA query_only=ON")     # belt & braces: read-only
        return con

    def query(self, db: Path, sql: str, params: tuple = ()) -> Optional[list]:
        """Read-only SELECT. Returns a list of sqlite3.Row, or None on failure."""
        if not db.exists():
            return None
        with self._lock:
            for attempt in (1, 2):
                con = self._conns.get(db)
                if con is None:
                    try:
                        con = self._open(db)
                        self._conns[db] = con
                    except sqlite3.Error as exc:
                        log_error(f"DB open failed {db}: {exc}")
                        return None
                try:
                    return con.execute(sql, params).fetchall()
                except sqlite3.Error as exc:
                    # schema changed / WAL checkpoint collision -> purge & retry
                    try:
                        con.close()
                    except sqlite3.Error:
                        pass
                    self._conns.pop(db, None)
                    if attempt == 1:
                        log_error(f"DB query failed {db}: {exc}")
                        return None

    def scalar(self, db: Path, sql: str, default=0, params: tuple = ()):
        rows = self.query(db, sql, params)
        if rows and rows[0][0] is not None:
            return rows[0][0]
        return default

    def close(self) -> None:
        with self._lock:
            for con in self._conns.values():
                try:
                    con.close()
                except sqlite3.Error:
                    pass
            self._conns.clear()

    def status(self) -> dict:
        main_ok = MAIN_DB.exists() and self.query(MAIN_DB, "SELECT 1") is not None
        gf_ok = GFCR_DB.exists() and self.query(GFCR_DB, "SELECT 1") is not None
        if main_ok and gf_ok:
            label, color = "LIVE", GREEN
        elif main_ok or gf_ok:
            label, color = "PARTIAL", YELLOW
        else:
            label, color = "MISSING", RED
        return {"label": label, "color": color, "main": main_ok, "gf": gf_ok}


# ─────────────────────────────────────────────────────────────────────────────
# MarketDaemon — live Yahoo Finance tape.
# A daemon thread polls yfinance every MARKET_POLL seconds and writes the
# snapshot into state.market_data (GIL makes the small dict write atomic).
# yfinance is imported lazily: no package / no internet / --offline simply
# leaves the tape in OFFLINE mode — the terminal never crashes without it.
# ─────────────────────────────────────────────────────────────────────────────
class MarketDaemon(threading.Thread):
    def __init__(self, state: TerminalState) -> None:
        super().__init__(daemon=True, name="MarketDaemon")
        self.state = state
        self._stop = threading.Event()

    def stop(self) -> None:
        self._stop.set()

    def run(self) -> None:
        try:
            import yfinance as yf          # lazy: degrades to OFFLINE tape
            import pandas as pd
        except ImportError:
            self.state.offline = True
            self.state.market_err = "yfinance not installed"
            return
        symbols = [t[1] for t in TICKERS]
        while not self._stop.is_set():
            try:
                df = yf.download(tickers=symbols, period="2d", interval="1d",
                                 progress=False, group_by="ticker", threads=8)
                if df is None or df.empty or df.shape[0] < 1:
                    raise RuntimeError("empty download")
                for tag, sym, _label in TICKERS:
                    try:
                        sub = df[sym] if isinstance(df.columns, pd.MultiIndex) else df
                        closes = sub["Close"].dropna()
                        if closes.empty:
                            continue
                        px = float(closes.iloc[-1])          # latest session
                        prev = float(closes.iloc[-2]) if closes.size > 1 else px
                        chg = px - prev
                        pct = chg / prev * 100.0 if prev else 0.0
                        self.state.market_data[tag] = (px, chg, pct)
                        self.state.market_live = True
                    except (KeyError, TypeError, ValueError, IndexError):
                        continue            # per-symbol failure: skip, keep old
            except Exception as exc:        # network / yahoo outage
                self.state.market_err = str(exc)[:90]
            if not self._stop.is_set():
                self._stop.wait(MARKET_POLL)


# ─────────────────────────────────────────────────────────────────────────────
# Background ETL job: pipes stdout/stderr into a ring buffer the UI renders
# live; killed via its own process group.
# ─────────────────────────────────────────────────────────────────────────────
class Job:
    def __init__(self, title: str, argv: list[str]) -> None:
        self.title = title
        self.argv = argv
        self.cmd = [PAPERFLOW_CMD, *argv]
        self.proc: Optional[subprocess.Popen] = None
        self.lines: deque[str] = deque(maxlen=400)
        self.rc: Optional[int] = None
        self.started = time.time()

    def start(self) -> None:
        self.proc = subprocess.Popen(
            self.cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1, cwd=PAPERFLOW_DIR, preexec_fn=os.setsid)
        threading.Thread(target=self._pump, daemon=True).start()

    def _pump(self) -> None:
        assert self.proc is not None and self.proc.stdout is not None
        for line in self.proc.stdout:
            self.lines.append(line.rstrip("\r\n"))
        self.rc = self.proc.wait()

    def kill(self) -> None:
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(os.getpgid(self.proc.pid), signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
            try:
                self.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(os.getpgid(self.proc.pid), signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    pass
        if self.rc is None:
            self.rc = -9

    @property
    def done(self) -> bool:
        return self.rc is not None

    @property
    def running(self) -> bool:
        return self.proc is not None and self.proc.poll() is None


# ─────────────────────────────────────────────────────────────────────────────
# Application: owns state, DB pool, console, and the key dispatch entry point.
# ─────────────────────────────────────────────────────────────────────────────
class App:
    def __init__(self) -> None:
        self.pool = DBPool([MAIN_DB, GFCR_DB])
        self.s = TerminalState()
        self.console = Console(force_terminal=True, highlight=False)
        self.action_log: deque[str] = deque(maxlen=2)   # footer "last actions"
        self._market: Optional[MarketDaemon] = None
        self._last_size: tuple[int, int] | None = None
        self.content_w: int = 80
        self._load_watchlist()

    # ── watchlist persistence ───────────────────────────────────────────
    def _load_watchlist(self) -> None:
        try:
            raw = json.loads(WATCHLIST_PATH.read_text())
            self.s.watch = {str(x).upper() for x in raw}
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            log_error(f"watchlist load: {exc}")
            self.s.watch = set()

    def save_watchlist(self) -> None:
        try:
            WATCHLIST_PATH.write_text(json.dumps(sorted(self.s.watch)))
        except OSError as exc:
            log_error(f"watchlist save: {exc}")

    # ── cache / refresh / toast ─────────────────────────────────────────
    def cache(self, key: str, fn: Callable):
        ck = (key, self.s.refresh)
        if ck not in self.s._cache:
            self.s._cache[ck] = fn()
        return self.s._cache[ck]

    def bump(self) -> None:
        self.s.refresh += 1
        self.s._cache.clear()

    def toast(self, msg: str) -> None:
        self.s.toast = msg
        self.s.toast_t = time.monotonic()

    def log_action(self, msg: str) -> None:
        self.action_log.append(f"{time.strftime('%H:%M:%S')} {msg}")

    @property
    def rating_year(self):
        return self.cache("round", lambda: self.pool.scalar(
            GFCR_DB, "SELECT MAX(year) FROM country_ratings_gfcr", None))

    def alert_count(self) -> int:
        def _a():
            rows = self.pool.query(GFCR_DB,
                "SELECT COUNT(*) c FROM country_ratings_gfcr "
                "WHERE year=(SELECT MAX(year) FROM country_ratings_gfcr) "
                "AND gfcr_score < ?", (SCORE_WARN,))
            return rows[0]["c"] if rows else 0
        return self.cache("alerts", _a)

    # ── live market lifecycle ──────────────────────────────────────────
    def market_start(self, offline: bool = False) -> None:
        """Boot the ticker tape. `offline` skips the thread entirely."""
        if offline:
            self.s.offline = True
            return
        daemon = MarketDaemon(self.s)
        daemon.start()
        self._market = daemon

    def market_stop(self) -> None:
        if self._market is not None:
            self._market.stop()
            self._market = None

    def fetch_quote(self, tick: str) -> None:
        """One-shot Yahoo quote (omnibar ticker): result arrives as a toast.
        Runs in a daemon thread so a slow network never blocks the UI."""
        def work() -> None:
            try:
                import yfinance as yf
            except ImportError:
                self.toast(f"{tick}: no yfinance (offline)")
                return
            try:
                h = yf.Ticker(tick).history(period="5d")
                closes = h["Close"].dropna()
                if closes.empty:
                    raise ValueError("no data")
                px = float(closes.iloc[-1])
                prev = float(closes.iloc[-2]) if closes.size > 1 else px
                chg, pct = px - prev, (px - prev) / prev * 100 if prev else 0.0
                self.toast(f"{tick}  {px:,.2f}  {chg:+,.2f}  ({pct:+,.1f}%)")
            except Exception:
                self.toast(f"{tick}: quote unavailable")
        threading.Thread(target=work, daemon=True, name="QuoteFetch").start()

    # ── ETL job runner ──────────────────────────────────────────────────
    def run_job(self, title: str, argv: list[str]) -> None:
        if self.s.job and self.s.job.running:
            self.toast("ETL job already running — X kills it.")
            return
        self.s.job = Job(title, argv)
        self.s.job.start()
        self.log_action(f"▶ {title}")

    def kill_job(self) -> None:
        if self.s.job and self.s.job.running:
            self.s.job.kill()
            self.toast("job killed.")

    # ── country registry ────────────────────────────────────────────────
    def countries(self) -> list[dict]:
        rows = self.cache("countries", lambda: self.pool.query(MAIN_DB,
            "SELECT iso3, name FROM countries ORDER BY name"))
        return [{"iso": r["iso3"], "name": r["name"]} for r in (rows or [])]

    def country_name(self, iso: str) -> str:
        name = self.cache("cname_" + iso, lambda: self.pool.scalar(
            MAIN_DB, "SELECT name FROM countries WHERE iso3=?", "", (iso,)))
        return name or iso

    # ── GFCR loaders ────────────────────────────────────────────────────
    def matrix_data(self) -> list[dict]:
        rows = self.pool.query(GFCR_DB,
            "SELECT r.iso3, COALESCE(c.name, r.iso3) name, r.gfcr_score, "
            "       r.gfcr_tier, r.s_eff, r.fiscal_stress, "
            "       r.external_vulnerability, r.dynamical_stress, "
            "       r.peer_group, r.year "
            "FROM country_ratings_gfcr r LEFT JOIN countries c ON c.iso3=r.iso3 "
            "WHERE r.year=(SELECT MAX(year) FROM country_ratings_gfcr)")
        out = [dict(r) for r in (rows or [])]
        for d in out:
            d["iso"] = d.pop("iso3")
        # 3-year gfcr score history -> trend sparkline per country
        hist = self.pool.query(GFCR_DB,
            "SELECT iso3, year, gfcr_score FROM country_ratings_gfcr "
            "ORDER BY iso3, year")
        trend: dict[str, list[float]] = {}
        for r in hist or []:
            trend.setdefault(r["iso3"], []).append(r["gfcr_score"])
        for d in out:
            d["trend"] = trend.get(d["iso"], [])[-5:]
        return out

    def heatmap_data(self) -> list[dict]:
        """40 countries × all 11 GFCR module risks, for the H-heatmap view.
        The summary matrix cache only carries 3 modules; the heatmap queries
        the full snapshot directly from country_ratings_gfcr."""
        cols = ", ".join(c for _n, c, _w in GFCR_MODULES)
        rows = self.pool.query(GFCR_DB,
            f"SELECT r.iso3, COALESCE(c.name, r.iso3) name, {cols} "
            "FROM country_ratings_gfcr r LEFT JOIN countries c ON c.iso3=r.iso3 "
            "WHERE r.year=(SELECT MAX(year) FROM country_ratings_gfcr)")
        out = [dict(r) for r in (rows or [])]
        for d in out:
            d["iso"] = d.pop("iso3")
        return out

    def rating_row(self, iso: str) -> Optional[dict]:
        rows = self.pool.query(GFCR_DB,
            "SELECT * FROM country_ratings_gfcr "
            "WHERE iso3=? AND year=(SELECT MAX(year) FROM country_ratings_gfcr)",
            (iso,))
        return dict(rows[0]) if rows else None

    def macro_series(self, iso: str) -> dict[str, list[tuple[int, float]]]:
        codes = [c for _, c, _ in MACRO_SERIES]
        marks = ",".join("?" * len(codes))
        rows = self.pool.query(MAIN_DB,
            "SELECT indicator_code, year, value FROM macro_indicators "
            "WHERE iso3=? AND indicator_code IN (" + marks + ") "
            "ORDER BY indicator_code, year", (iso, *codes))
        out: dict[str, list[tuple[int, float]]] = {}
        for r in rows or []:
            out.setdefault(r["indicator_code"], []).append((r["year"], r["value"]))
        return out

    def narrative(self, iso: str) -> str:
        return self.pool.scalar(MAIN_DB,
            "SELECT narrative_summary FROM country_ratings WHERE iso3=? "
            "AND narrative_summary IS NOT NULL AND narrative_summary!='' "
            "ORDER BY year DESC LIMIT 1", "", (iso,))

    # ── audit / policy loaders ──────────────────────────────────────────
    def audit_rows(self, imputed_only: bool) -> list[dict]:
        sql = ("SELECT iso3, year, indicator, source, fallback_source, "
               "imputation_flag, raw_value, final_value FROM data_audit")
        if imputed_only:
            sql += " WHERE imputation_flag IN ('estimated','fallback_static','missing')"
        sql += " ORDER BY year DESC, iso3 LIMIT 500"
        rows = self.pool.query(MAIN_DB, sql)
        out = []
        for r in rows or []:
            d = dict(r)
            d["iso"] = d.pop("iso3")
            out.append(d)
        return out

    def policy_events(self) -> list[dict]:
        rows = self.pool.query(MAIN_DB,
            "SELECT id, iso3, event_date, event_type, description, source_url "
            "FROM policy_events ORDER BY event_date")
        return [dict(r) for r in (rows or [])]

    def policy_impact(self, iso: str, year: int) -> list[tuple]:
        """(name, before_avg, after_avg, delta) for 5y-before vs 5y-after."""
        macro = self.macro_series(iso)
        out = []
        for name, code, _kind in MACRO_SERIES:
            pts = macro.get(code, [])
            before = [v for (y, v) in pts if year - 5 <= y < year]
            after = [v for (y, v) in pts if year <= y <= year + 4]
            b = sum(before) / len(before) if before else None
            a = sum(after) / len(after) if after else None
            delta = (a - b) if (b is not None and a is not None) else None
            out.append((name, b, a, delta))
        return out


# ─────────────────────────────────────────────────────────────────────────────
# Formatting helpers
# ─────────────────────────────────────────────────────────────────────────────
def num_or_str(v: object) -> str:
    """Format a cell value that may be REAL or TEXT (e.g. pension_system_type)."""
    if v is None:
        return "—"
    if isinstance(v, (int, float)):
        return f"{float(v):.1f}" if not (float(v) != float(v)) else "—"  # NaN guard
    return str(v)[:12]


def hum(n) -> str:
    try:
        return f"{float(n):,.0f}"
    except (TypeError, ValueError):
        return "—"


def pct(v: Optional[float], nd: int = 0) -> str:
    if v is None:
        return "—"
    return f"{v * 100:.{nd}f}%"


def fmt_size(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}TB"


def tier_short(tier: Optional[str]) -> str:
    return (tier or "?").split(" — ")[0] or "?"


def tier_color(tier: Optional[str]) -> str:
    t = (tier or "").upper()
    if t.startswith("AAA"):
        return "bold green"
    if t.startswith("AA"):
        return "green"
    if t.startswith("A "):
        return "bright_green"
    if t.startswith("BBB"):
        return "yellow"
    if t.startswith("BB"):
        return "bright_yellow"
    if t.startswith("B "):
        return "bright_red"
    if t.startswith("CCC"):
        return "bold red"
    return "white"


def tier_sort(tier: Optional[str]) -> int:
    return {"AAA": 1, "AA": 2, "A": 3, "BBB": 4, "BB": 5, "B": 6, "CCC": 7}.get(
        tier_short(tier), 9)


def score_cell(v: Optional[float]) -> Text:
    """GFCR capacity cell — green/amber/red by the 70/40 bands."""
    if v is None:
        return Text("—", style=DIM)
    color = GREEN if v >= SCORE_OK else (YELLOW if v >= SCORE_WARN else RED)
    return Text(f"{v:.1f}", style=color)


def risk_cell(v: Optional[float], nd: int = 0) -> Text:
    """Risk-form 0-1 cell — red = high vulnerability, green = low risk."""
    if v is None:
        return Text("—", style=DIM)
    color = GREEN if v < RISK_OK else (YELLOW if v < RISK_WARN else RED)
    return Text(pct(v, nd), style=color)


def sparkline8(vals: list[float], width: int = 7) -> Text:
    """ASCII micro-chart ▁▂▃▄▅▆▇█ over the observed range (Bloomberg spark)."""
    if not vals:
        return Text("·" * width, style=DIM)
    if len(vals) == 1:                     # only one rating round so far
        return Text("·" * width, style=DIM)
    lo, hi = min(vals), max(vals)
    if hi - lo < 1e-9:
        return Text("▄" * width, style=CYAN)
    step = (hi - lo) / (len(SPARK_CHARS) - 1)
    window = vals[-width:]
    out = "".join(SPARK_CHARS[min(len(SPARK_CHARS) - 1,
                                  int((v - lo) / step))] for v in window)
    return Text(out, style=CYAN)


def risk_bar(v: Optional[float], width: int = 10) -> Text:
    """Mini risk bar 0-100% — fills red/yellow/green by severity."""
    v = 0.0 if v is None else max(0.0, min(1.0, float(v)))
    filled = int(round(v * width))
    color = GREEN if v < RISK_OK else (YELLOW if v < RISK_WARN else RED)
    return Text("█" * filled + "░" * (width - filled), style=color)


def ci_bar(p05: float, p50: float, p95: float, width: int = 16) -> Text:
    """Uncertainty interval strip: ├───●───┤ style (p05 · p50 · p95)."""
    if p05 is None or p50 is None or p95 is None or p95 <= p05:
        return Text("—", style=DIM)
    lo, hi = min(p05, p95), max(p05, p95)
    rng = max(1e-9, hi - lo)
    a = max(0, min(width - 1, int((p05 - lo) / rng * (width - 1))))
    b = max(0, min(width - 1, int((p50 - lo) / rng * (width - 1))))
    c = max(0, min(width - 1, int((p95 - lo) / rng * (width - 1))))
    cells = ["░"] * width
    cells[a], cells[c] = "┃", "┃"
    cells[b] = "●"
    t = Text("".join(cells), style=CYAN)
    return t


def col_window(cols: list, hscroll: int, avail: int) -> tuple[int, int]:
    """Pick the contiguous run of columns that fits `avail`, honouring hscroll."""
    n = len(cols)
    if n == 0:
        return 0, 0
    widths = [w + 2 for (_h, w, _f) in cols]
    k, acc = 0, 0
    while k < n and acc + widths[k] <= avail:
        acc += widths[k]
        k += 1
    k = max(1, k)
    max_start = max(0, n - k)
    start = max(0, min(hscroll, max_start))
    return start, min(n, start + k)


def pad_pair(left: Text, right: Text, width: int) -> Text:
    """Line with both sides justified to `width` (Bloomberg header style).
    If the pair overflows, the left side is trimmed so the right (status)
    side never wraps on narrow terminals."""
    overflow = width - len(left.plain) - len(right.plain)
    pad = max(1, overflow)
    if overflow < 1:                       # trim left so status never wraps
        keep = max(0, width - len(right.plain) - 1)
        if keep < len(left.plain):
            left = left[:keep]
    out = Text()
    out.append_text(left)
    out.append(" " * pad)
    out.append_text(right)
    return out

