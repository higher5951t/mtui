def _market_items(state: TerminalState) -> list[tuple[str, dict]]:
    """Return (tag, data_dict) pairs in current sort/filter order."""
    items = []
    all_tickers = list(TICKERS) + list(state.market_custom)
    for tag, _sym, _label, _cat in all_tickers:
        d = state.market_data.get(tag)
        if d is None:
            continue
        if state.market_filter_cat and d.get("category", "") != state.market_filter_cat:
            continue
        items.append((tag, d))
    sk = state.market_sort
    if sk == "px":
        items.sort(key=lambda x: x[1]["px"], reverse=True)
    elif sk == "chg":
        items.sort(key=lambda x: x[1]["chg"], reverse=True)
    elif sk == "pct":
        items.sort(key=lambda x: x[1]["pct"], reverse=True)
    elif sk == "name":
        items.sort(key=lambda x: x[1]["label"].lower())
    # "default" preserves TICKERS declaration order
    return items


def _market_ascii_chart(history: list[float], w: int, h: int) -> Text:
    """Render a 30-day close-history ASCII line chart into a Text block."""
    if not history or len(history) < 2:
        return Text("  (insufficient history for chart)", style=DIM)
    lo, hi = min(history), max(history)
    if hi - lo < 1e-9:
        return Text("  (flat series)", style=DIM)
    rows = max(4, h - 2)
    cols = max(20, w - 4)
    # downsample to `cols` points
    step = max(1, len(history) // cols)
    pts = history[::step][:cols]
    grid = [[" "] * cols for _ in range(rows)]
    for x, v in enumerate(pts):
        y = int((1 - (v - lo) / (hi - lo)) * (rows - 1))
        y = max(0, min(rows - 1, y))
        grid[y][x] = "●"
        # connect with vertical bars to previous point
        if x > 0:
            prev_v = pts[x - 1]
            prev_y = int((1 - (prev_v - lo) / (hi - lo)) * (rows - 1))
            prev_y = max(0, min(rows - 1, prev_y))
            for yy in range(min(prev_y, y) + 1, max(prev_y, y)):
                grid[yy][x] = "│"
    out = Text()
    for r, row in enumerate(grid):
        # y-axis label on first column
        if r == 0:
            out.append(f"{hi:>9.2f} ┤", style=DIM)
        elif r == rows - 1:
            out.append(f"{lo:>9.2f} ┤", style=DIM)
        elif r == rows // 2:
            mid = (hi + lo) / 2
            out.append(f"{mid:>9.2f} ┤", style=DIM)
        else:
            out.append(" " * 10 + "│", style=DIM)
        out.append("".join(row), style=CYAN)
        out.append("\n")
    return out


def _render_candlestick_chart(ohlc: list[dict], w: int, h: int) -> Text:
    """Render an ASCII candlestick chart from OHLCV data."""
    if not ohlc or len(ohlc) < 2:
        return Text("  (insufficient history for chart)", style=DIM)

    max_candles = max(10, (w - 15) // 2)
    candles = [c for c in ohlc
               if c.get("o") == c.get("o") and c.get("h") == c.get("h")
               and c.get("l") == c.get("l") and c.get("c") == c.get("c")][-max_candles:]
    if len(candles) < 2:
        return Text("  (insufficient history)", style=DIM)

    lo = min(c['l'] for c in candles)
    hi = max(c['h'] for c in candles)
    if hi - lo < 1e-9:
        return Text("  (flat series)", style=DIM)

    rows = max(8, h - 2)
    grid: list[list[tuple[str, str]]] = [[(" ", DIM) for _ in range(len(candles)*2)] for _ in range(rows)]

    def y_pos(val):
        return max(0, min(rows - 1, int((1 - (val - lo) / (hi - lo)) * (rows - 1))))

    for i, c in enumerate(candles):
        x = i * 2
        y_h = y_pos(c['h'])
        y_l = y_pos(c['l'])
        y_o = y_pos(c['o'])
        y_c = y_pos(c['c'])

        up = c['c'] >= c['o']
        body_char = "█" if up else "░"
        wick_char = "│"
        body_color = "bright_green" if up else "bright_red"
        wick_color = "green" if up else "red"

        for y in range(min(y_h, y_l), max(y_h, y_l) + 1):
            grid[y][x] = (wick_char, wick_color)

        y_top = min(y_o, y_c)
        y_bot = max(y_o, y_c)
        if y_top == y_bot:
            grid[y_top][x] = ("─", "yellow")
        else:
            for y in range(y_top, y_bot + 1):
                grid[y][x] = (body_char, body_color)

    out = Text()
    for r in range(rows):
        if r == 0:
            out.append(f"{hi:>9.2f} ┤", style=DIM)
        elif r == rows - 1:
            out.append(f"{lo:>9.2f} ┤", style=DIM)
        elif r == rows // 2:
            mid = (hi + lo) / 2
            out.append(f"{mid:>9.2f} ┤", style=DIM)
        else:
            out.append(" " * 10 + "│", style=DIM)
        for x in range(len(candles) * 2):
            char, color = grid[r][x]
            out.append(char, style=color)
        out.append("\n")
    return out


def _day_range_bar(low: float, high: float, curr: float, width: int = 24) -> Text:
    """Visual indicator for where the current price sits in the day's range."""
    if not (low == low and high == high and curr == curr) or high <= low:
        return Text("—")
    pos = int((curr - low) / (high - low) * (width - 1))
    pos = max(0, min(width - 1, pos))
    t = Text(f"{low:>9.2f} ", style=DIM)
    t.append("┣", style=DIM)
    for i in range(width - 2):
        if i == pos:
            t.append("●", style="bold yellow")
        else:
            t.append("━", style=DIM)
    t.append("┫", style=DIM)
    t.append(f" {high:.2f}", style=DIM)
    return t


def _ma_gauge(ma50: float, ma200: float, px: float, width: int = 24) -> Text:
    """Visual indicator for MA50/MA200 crossover relative to price."""
    if not (ma50 > 0 and ma200 > 0): return Text("—")
    lo = min(px, ma50, ma200)
    hi = max(px, ma50, ma200)
    if hi - lo < 1e-9: return Text("—")

    def pos(val):
        return max(0, min(width - 1, int((val - lo) / (hi - lo) * (width - 1))))
    p_px, p_50, p_200 = pos(px), pos(ma50), pos(ma200)

    t = Text(f"{lo:>9.2f} ", style=DIM)
    t.append("┣", style=DIM)
    for i in range(width - 2):
        if i == p_px: t.append("●", style="bold yellow")
        elif i == p_50: t.append("5", style="bright_green")
        elif i == p_200: t.append("2", style="bright_red")
        else: t.append("━", style=DIM)
    t.append("┫", style=DIM)
    t.append(f" {hi:.2f}", style=DIM)
    return t


