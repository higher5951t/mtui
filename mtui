def _render_nav_chart(nav_rows: list[dict], w: int, h: int) -> RenderableType:
    """Render NAV vs Benchmark ASCII chart using plotext."""
    if not nav_rows or len(nav_rows) < 2:
        return Panel(Text("Insufficient NAV data to chart.", style=DIM),
                     title="NAV CURVE", border_style="grey30", box=box.SIMPLE)
    try:
        import plotext as plt
    except ImportError:
        return Panel(Text("Install plotext for NAV chart.", style=DIM),
                     title="NAV CURVE", border_style="grey30", box=box.SIMPLE)

    dates = [r["date"] for r in nav_rows]
    navs = [float(r["nav"]) for r in nav_rows]
    bench = [float(r["benchmark"]) for r in nav_rows]

    plt.clf()
    plt.clc()
    plt.theme("dark")
    plt.plotsize(max(20, w - 4), max(6, h - 4))
    plt.date_form("Y-m-d")          # NAV dates arrive as ISO strings (2026-08-03)
    plt.plot(dates, navs, color="green", label="Strategy NAV")
    plt.plot(dates, bench, color="yellow", label="SPY Benchmark")
    plt.title("NAV vs SPY (Buy & Hold)")
    plt.grid(0)

    return Panel(Text.from_ansi(plt.build()), border_style="grey30",
                 box=box.SIMPLE, padding=(0, 0))


